---
// About and legal, as a card over the menu: what Dreamports is, the rules, privacy and credits.
import Key from './Key.astro';
import OwnGameSteps from './OwnGameSteps.astro';
import { CONTACT_EMAIL, OWNER_URL, SOURCE_URL, SUGGEST_URL, pageTitle } from '../lib/site';

interface Props {
  // Open when the page loads, at /about/.
  open?: boolean;
}

const { open = false } = Astro.props;
const Title = open ? 'h1' : 'h2';
const Sec = open ? 'h2' : 'h3';
const sections = [
  { id: 'dreamport', label: 'What a Dreamport is' },
  { id: 'kinds', label: 'What you’ll find here' },
  { id: 'own-game', label: 'Bring your own game' },
  { id: 'legal', label: 'Not affiliated' },
  { id: 'privacy', label: 'Your privacy' },
  { id: 'credits', label: 'Credits' },
  { id: 'contact', label: 'Get in touch' },
];
---

<dialog
  class="card card-about"
  id="card-about"
  data-card="about"
  data-path="/about/"
  data-title={pageTitle('About and legal')}
  aria-labelledby="about-title"
  open={open}
>
  <div class="about">
    <nav class="about-nav" aria-label="About and legal">
      <Title id="about-title">About and legal</Title>
      {
        sections.map((section, index) => (
          <a href={`#${section.id}`} data-sec={section.id} aria-current={index === 0 ? 'true' : undefined} autofocus={index === 0}>
            {section.label}
          </a>
        ))
      }
    </nav>
    <div class="about-text prose" tabindex="0">
      <section id="dreamport">
        <Sec>What a Dreamport is</Sec>
        <p>dreamports.net is a home for enhanced fan ports of classic games, made by a fan, for fans.</p>
        <p>
          A Dreamport is the port fans always dreamed of: the game you remember, with the extras you wished it
          had. It starts from the game as you know it, then adds the things fans have asked for over the years.
        </p>
      </section>

      <section id="kinds">
        <Sec>What you’ll find here</Sec>
        <ul>
          <li>
            <strong>Dreamports.</strong> The ports made here, by <a href={OWNER_URL}>Nahuel Genchi</a>.
          </li>
          <li>
            <strong>Mash-ups.</strong> Great ports made by other fans, and fan games that aren’t ports, like
            Kirby’s Dead Land. Dreamports links to other fans’ own pages and credits the people who made them.
          </li>
        </ul>
      </section>

      <section id="own-game">
        <Sec>Bring your own game</Sec>
        <p>
          Dreamports never hosts game files: no <abbr class="caps" title="read-only memory">ROMs</abbr>, no game
          data and nothing taken from a game. It only lists projects that ask you to use your own legal copy, and
          before every play or download link it asks you to confirm that you are.
        </p>
        <OwnGameSteps />
      </section>

      <section id="legal">
        <Sec>Not affiliated with any publisher</Sec>
        <p>
          Dreamports is an unofficial fan project. It is not affiliated with, endorsed by or sponsored by Sega,
          Nintendo or any other publisher. Game names and trademarks belong to their owners, and appear here only
          to say which game a project works with.
        </p>
        <p>
          The site’s own design never uses publishers’ logos, box art or characters. Pictures of games come only
          from the makers’ own recordings.
        </p>
      </section>

      <section id="privacy">
        <Sec>Your privacy</Sec>
        <p>
          There are no accounts, no ads and no cookies. The site keeps a few small notes in your own browser:
          whether you switched on menu sounds, which look and motion you picked, and, until you close the tab,
          which games you’ve confirmed you own. Those notes never leave your device, and “Forget my choices” in
          Settings clears your menu choices at any time.
        </p>
        <p>
          Sonic Advance Dreamport, played here on dreamports.net, keeps its own notes in your browser: your settings,
          the emeralds you’ve collected and, unless you untick “Remember on this device”, your game files, so you don’t
          have to add them on every visit. They never leave your device either, and clearing this site’s data removes them.
        </p>
        <p>
          To see which pages people read, the site counts visits with <a href="https://www.cloudflare.com/web-analytics/">Cloudflare Web Analytics</a>.
          It notes the page you opened, the site that sent you there, your browser, your country and how fast the
          page loaded. It stores nothing in your browser, doesn’t keep your IP address and doesn’t follow you to
          other sites.
        </p>
      </section>

      <section id="credits">
        <Sec>Credits</Sec>
        <ul>
          <li>
            <strong>The site.</strong> Made by <a href={OWNER_URL}>Nahuel Genchi</a>.
            Its <a href={SOURCE_URL}>source code</a> is free to reuse under the MIT License.
          </li>
          <li>
            <strong>Type.</strong> Set in <a href="https://github.com/IdreesInc/Monocraft">Monocraft</a> by
            Idrees Hassan, under the <a href="/licenses/monocraft-OFL.txt">SIL Open Font License</a>.
          </li>
          <li>
            <strong>The star.</strong> Drawn by Narik,
            from <a href="https://soulofkiran.itch.io/pixel-art-animated-star">Pixel Art Animated Star</a>.
          </li>
          <li>
            <strong>The menu’s sounds.</strong> Made for Dreamports, and played by your own browser.
          </li>
        </ul>
      </section>

      <section id="contact">
        <Sec>Suggest a port, report a problem or get in touch</Sec>
        <p>
          Open an <a href={SUGGEST_URL}>issue on GitHub</a>. It takes a free GitHub account, and you don’t need to
          be a developer to fill it in. Please never attach game files.
        </p>
        <p>
          For anything else, including messages from publishers or other rights holders, write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </section>
    </div>
  </div>
  <a class="card-close" href="/" data-close><Key label="Esc" pad="B" round />Close</a>
</dialog>
