---
// "before you play": the visitor confirms they're using their own legal copy of the game
// before any play or download link opens. Without JavaScript, the browser itself refuses to
// follow a link until the box is ticked, and the card shows when the address ends in #play.
// Play links open in the same tab; download links open in a new one, so the menu stays put.
import Key from './Key.astro';
import Star from './Star.astro';
import { gameUrl, pageTitle, type Game } from '../lib/site';

interface Props {
  game: Game;
  // The card of the page's own game answers to #play.
  own?: boolean;
}

const { game, own = false } = Astro.props;
const { text, confirm, links, note } = game.data.ownCopy;
const id = game.id;
const downloads = links.every((link) => link.icon === 'download');
const lockedNote = downloads ? 'tick the box to unlock the downloads.' : 'tick the box to unlock play.';
const nudgeNote = downloads ? 'tick the box first, then download.' : 'tick the box first, then press play.';
---

<dialog
  class="card card-gate"
  id={own ? 'play' : `play-${id}`}
  data-card="gate"
  data-game={id}
  data-path={`${gameUrl(game)}#play`}
  data-title={pageTitle(game.data.title)}
  aria-labelledby={`gate-title-${id}`}
>
  <div class="card-body">
    <h2 class="gate-title" id={`gate-title-${id}`}><Star /><span>before you play</span></h2>
    <p class="gate-text">{text}</p>
    <form
      class="gate-form"
      method="get"
      action={links[0].href}
      data-locked-note={lockedNote}
      data-nudge-note={nudgeNote}
    >
      <label class="check" for={`own-${id}`}>
        <input type="checkbox" id={`own-${id}`} required autofocus />
        <span>{confirm}</span>
      </label>
      <div class="gate-actions">
        <div class="gate-buttons">
          {
            links.map((link, index) => (
              <button
                type="submit"
                class:list={['btn', index > 0 && 'btn--alt']}
                formaction={link.href}
                formtarget={link.icon === 'download' ? '_blank' : undefined}
                data-icon={link.icon}
                aria-describedby={`gate-note-${id}`}
              >
                <svg class="icon-lock" viewBox="0 0 8 7" width="16" height="14" fill="currentColor" aria-hidden="true">
                  <path d="M2 0h4v1H2zM1 1h1v2H1zM6 1h1v2H6zM0 3h8v1H0zM0 4h3v2H0zM5 4h3v2H5zM0 6h8v1H0z" />
                </svg>
                <span class="icon-go" aria-hidden="true">{link.icon === 'download' ? '↓' : '▶'}</span>
                {link.label}
              </button>
            ))
          }
        </div>
        <p id={`gate-note-${id}`} class="gate-note" aria-live="polite">
          <span class="note-locked">{lockedNote}</span>
          <span class="note-open">{note}</span>
        </p>
      </div>
    </form>
  </div>
  <a class="card-close" href="#" data-close><Key label="esc" pad="B" round />close</a>
</dialog>
