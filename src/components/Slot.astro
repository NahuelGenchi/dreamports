---
// One place in the launcher's row: a system, which shows its Dreamports, or in the Make row those being made for it; a game, which links to its own page; or in the Make row, a Dreamport being made,
// which links to its page there, or the way to start a Dreamport, which leads to the README's steps. There, a Dreamport
// also carries its two numbers, which the nameplate shows under it once it's selected, and under them how many of its
// pieces are free to take, when there are any.
import Tile from './Tile.astro';
import { FILTERS, MAKE_GUIDE_URL, gameUrl, makeUrl, type Game } from '../lib/site';
import { fullyPorted, numbersOf } from '../lib/dreamports';
import type { System } from '../lib/systems';

interface Props {
  game?: Game;
  // a system, and whether none of its Dreamports is finished, which only the Dreamports row asks
  system?: System & { unfinished: boolean };
  // the system a game is for
  of?: string;
  index: number;
  // a place in the Make row: a Dreamport's opens its page there, and a system's shows those being made for it
  make?: boolean;
  // the Make row's last place: how to start a Dreamport
  start?: boolean;
  // in the Make row, the pieces free to take, when GitHub could be read for this build
  free?: { help: string };
}

const { game, system, of, index, make = false, start = false, free } = Astro.props;
const detail = game && !make ? [game.data.platform, game.data.year].filter(Boolean).join(' · ') : '';
const numbers = make && game ? numbersOf(game.data) : undefined;
// in its own row, a Dreamport whose code isn't all ported, which the row leaves out until Settings show it
const unfinished = !!game && !make && !fullyPorted(game);
const href = game && (make ? makeUrl(game.data.game) : gameUrl(game));
// a system's row is its own row's address with the system after a #
const rowPath = FILTERS.find((filter) => filter.key === (make ? 'make' : 'dreamports'))!.path;
const START = {
  title: 'Start a Dreamport',
  help: 'Pick a game you own, then paste one sentence into a coding agent. It sets everything up and makes the first piece for you.',
};
---

{
  system ? (
    <a
      class="slot"
      href={`${rowPath}#${system.id}`}
      data-index={index}
      data-system={system.id}
      data-title={system.name}
      data-icon={system.icon}
      data-unfinished={system.unfinished ? '' : undefined}
      draggable="false"
    >
      <span class="lift">
        <span class="tile" aria-hidden="true">
          <span class="screen system">
            <i class="sys-icon" style={`--icon: url(${system.icon})`} />
          </span>
        </span>
      </span>
      <span class="sr-only">{system.name}</span>
    </a>
  ) : start ? (
    <a class="slot" href={MAKE_GUIDE_URL} data-index={index} data-title={START.title} data-help={START.help} data-href={MAKE_GUIDE_URL} draggable="false">
      <span class="lift">
        <span class="tile" aria-hidden="true">
          <span class="screen start">
            <svg class="st-plus" viewBox="0 0 16 16" shape-rendering="crispEdges">
              <path d="M7 2h2v12H7zM2 7h12v2H2z" />
            </svg>
          </span>
        </span>
      </span>
      <span class="sr-only">
        {START.title}
        <span class="slot-help">{START.help}</span>
      </span>
    </a>
  ) : game ? (
    <a
      class="slot"
      href={href}
      data-index={index}
      data-game={game.id}
      data-of={of}
      data-card={`${make ? 'make' : 'inspect'}-${game.id}`}
      data-title={game.data.title}
      data-detail={detail}
      data-numbers={numbers}
      data-help={free?.help || undefined}
      data-unfinished={unfinished ? '' : undefined}
      draggable="false"
    >
      <i class="glow" style={`--g: ${game.data.glow}`} />
      <span class="lift">
        <Tile game={game} />
      </span>
      <span class="sr-only">
        {game.data.title}{detail && `, ${detail}`}
        {numbers && <span class="slot-numbers">{numbers}</span>}
        {free?.help && <span class="slot-help">{free.help}</span>}
      </span>
    </a>
  ) : null
}
