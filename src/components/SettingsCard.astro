---
// Settings: menu sounds, light or dark, and full or calm motion. It needs JavaScript, like
// everything it changes, so the menu shows its button only when JavaScript runs.
import Key from './Key.astro';
---

<dialog class="card card-settings" id="card-settings" data-card="settings" aria-labelledby="settings-title">
  <div class="card-body">
    <h2 class="card-title" id="settings-title">Settings</h2>
    <div class="set-list">
      <div class="set-row">
        <div class="set-text">
          <span class="set-label" id="snd-label">Menu sounds</span>
          <span class="set-desc">Soft clicks and chimes as you move. Made for Dreamports and played by your own browser.</span>
        </div>
        <button type="button" class="switch" role="switch" aria-checked="false" aria-labelledby="snd-label" id="snd-switch" autofocus>
          <span class="switch-track"><span class="switch-knob"></span></span>
        </button>
      </div>
      <div class="set-row">
        <div class="set-text">
          <span class="set-label" id="theme-label">Look</span>
          <span class="set-desc" id="theme-desc">Light, or dark for the evening.</span>
        </div>
        <div class="seg" role="radiogroup" aria-labelledby="theme-label">
          <input type="radio" name="theme" id="theme-light" value="light" /><label for="theme-light">Light</label>
          <input type="radio" name="theme" id="theme-dark" value="dark" /><label for="theme-dark">Dark</label>
        </div>
      </div>
      <div class="set-row">
        <div class="set-text">
          <span class="set-label" id="motion-label">Motion</span>
          <span class="set-desc" id="motion-desc">Calm keeps the games still and swaps the slides for fades.</span>
        </div>
        <div class="seg" role="radiogroup" aria-labelledby="motion-label">
          <input type="radio" name="motion" id="motion-full" value="full" /><label for="motion-full">Full</label>
          <input type="radio" name="motion" id="motion-calm" value="calm" /><label for="motion-calm">Calm</label>
        </div>
      </div>
    </div>
    <p class="card-note">
      <span id="memory-note">The menu remembers nothing yet.</span>{' '}
      <span id="forget-wrap" hidden><button type="button" class="linkish" id="btn-forget">Forget my choices</button> ·{' '}</span>
      <a class="linkish" id="btn-privacy" href="/about/#privacy">Your privacy</a>
    </p>
  </div>
  <button type="button" class="card-close" data-close><Key label="Esc" pad="B" round />Close</button>
</dialog>
