---
// The Dreamports doorway from the README banner, drawn as pixel rectangles.
// K ink, G gold, D deep gold, W white. In dark mode an outline (O) keeps it visible.
interface Props {
  scale?: number;
  class?: string;
}

const { scale = 1, class: className } = Astro.props;

const DOOR = [
  '....KKKKKKK....',
  '..KKKKKKKKKKK..',
  '.KKKKKKGKKKKKK.',
  '.KKKKKKGKKKKKK.',
  'KKWKKKGGGKKKKKK',
  'KKKKGGGGGGGKKKK',
  'KKKKKKGGGKKKWKK',
  'KKKKKKKGKKKKKKK',
  'KKKKKKKGKKKKKKK',
  'KKKKKKKKKKKKKKK',
  'KKKWKKKKKKKKKKK',
  'KKKKKKKKKKKWKKK',
  'KKKKKKKKKKKKKKK',
  'KKKKKKKDKKKKKKK',
  'KKKKKKDDDKKKKKK',
  'KKKKKDDDDDKKKKK',
  'KKKKDDDDDDDKKKK',
  'KKKKKKKKKKKKKKK',
];

const width = DOOR[0].length + 2;
const height = DOOR.length + 2;
const cell = (x: number, y: number) => DOOR[y - 1]?.[x - 1] ?? '.';
const filled = (x: number, y: number) => cell(x, y) !== '.';

const grid = Array.from({ length: height }, (_, y) =>
  Array.from({ length: width }, (_, x) => {
    if (filled(x, y)) return cell(x, y);
    const touches = filled(x + 1, y) || filled(x - 1, y) || filled(x, y + 1) || filled(x, y - 1);
    return touches ? 'O' : '.';
  }),
);

const runs: { x: number; y: number; w: number; c: string }[] = [];
grid.forEach((row, y) => {
  for (let x = 0; x < width; ) {
    const c = row[x];
    let end = x + 1;
    while (end < width && row[end] === c) end++;
    if (c !== '.') runs.push({ x, y, w: end - x, c: c.toLowerCase() });
    x = end;
  }
});
---

<svg
  class:list={['door', className]}
  viewBox={`0 0 ${width} ${height}`}
  width={width * scale}
  height={height * scale}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {runs.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" class={`door-${r.c}`} />)}
</svg>
