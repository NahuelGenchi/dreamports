---
// The whole site is this one screen: a top bar with the filters (or the search field, while a
// search is on), one row of games across the middle, corner buttons at the bottom, and cards
// that open over it. Every page shows it, with its own card open: a game's own page opens that
// game's card, and /about/ opens about.
// Without JavaScript the row is a plain list of links and the open card is the page's text.
import AboutCard from './AboutCard.astro';
import Doorway from './Doorway.astro';
import GateCard from './GateCard.astro';
import InspectCard from './InspectCard.astro';
import Key from './Key.astro';
import SettingsCard from './SettingsCard.astro';
import Slot from './Slot.astro';
import { FILTERS, SECTIONS, SLOTS, gameUrl, getGames, type Filter, type FilterKey, type Game } from '../lib/site';

interface Props {
  filter: FilterKey;
  // The game the row starts on.
  selected?: string;
  // The card that is open when the page loads.
  open?: 'about' | 'inspect';
}

const { filter, selected, open } = Astro.props;
const games = await getGames();
const rows = FILTERS.map((f) => {
  const list: (Game | undefined)[] = games.filter((game) => f.kinds.includes(game.data.kind));
  while (list.length < SLOTS) list.push(undefined);
  return { filter: f, list };
});
const current = rows.find((row) => row.filter.key === filter)!;
const selIndex = Math.max(0, current.list.findIndex((game) => game && game.id === selected));
const selGame = current.list[selIndex];
const Heading = open ? 'h2' : 'h1';
// Every address that shows a filter: its own, and the older one for each kind of game in it.
const pathsFor = (f: Filter) =>
  [f.path, ...SECTIONS.filter((s) => f.kinds.includes(s.kind)).map((s) => `/${s.path}/`)].join(' ');
---

<div class="launcher" id="launcher" data-filter={filter} data-sel={selIndex}>
  <header class="topbar">
    <div class="side">
      <div class="pill clock" aria-hidden="true"><Doorway /><time id="clock"></time></div>
    </div>
    <div class="filters">
      <button type="button" class="shoulder" id="btn-l" aria-label="Previous filter" aria-keyshortcuts="L Q">L</button>
      <div class="tabs" role="tablist" aria-label="Filters">
        {
          FILTERS.map((f, i) => (
            <Fragment>
              {i > 0 && <span class="tab-sep" aria-hidden="true">·</span>}
              <a
                class="tab"
                role="tab"
                id={`tab-${i}`}
                href={f.path}
                data-filter={f.key}
                data-title={f.title}
                data-paths={pathsFor(f)}
                aria-selected={f.key === filter ? 'true' : 'false'}
                aria-controls="row"
                tabindex={f.key === filter ? undefined : -1}
              >
                {f.label}
              </a>
            </Fragment>
          ))
        }
        <i class="tab-mark" id="tab-mark" aria-hidden="true"></i>
      </div>
      <button type="button" class="shoulder" id="btn-r" aria-label="Next filter" aria-keyshortcuts="R E">R</button>
      <div class="search" id="search" role="search" hidden>
        <svg class="s-icon" viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M1 0h4v1H1zM0 1h1v4H0zM5 1h1v4H5zM1 5h4v1H1zM5 5h2v2H5zM7 7h2v2H7z"></path>
        </svg>
        <input
          type="search"
          id="search-input"
          placeholder={`Search ${current.filter.label}`}
          aria-label={`Search ${current.filter.label}`}
          aria-controls="row"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
        />
        <button type="button" class="search-end" id="search-end" aria-label="End the search" aria-keyshortcuts="Escape">
          <Key label="Esc" pad="B" round />
          <svg viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
            <path d="M0 0h1v1H0zM6 0h1v1H6zM1 1h1v1H1zM5 1h1v1H5zM2 2h1v1H2zM4 2h1v1H4zM3 3h1v1H3zM2 4h1v1H2zM4 4h1v1H4zM1 5h1v1H1zM5 5h1v1H5zM0 6h1v1H0zM6 6h1v1H6z"></path>
          </svg>
        </button>
      </div>
    </div>
    <div class="side end">
      <button type="button" class="pill status" id="status" aria-label="Settings">
        <svg id="ico-sound" viewBox="0 0 11 9" shape-rendering="crispEdges" aria-hidden="true"></svg>
        <svg id="ico-pad" viewBox="0 0 13 8" shape-rendering="crispEdges" aria-hidden="true"></svg>
      </button>
    </div>
  </header>

  <main class="stage" id="stage">
    <Heading class="sr-only">Dreamports</Heading>
    <div class="row" id="row" aria-label={`Games: ${current.filter.label}`}>
      {current.list.map((game, i) => <Slot game={game} index={i} />)}
    </div>
    <div class="cursor" id="cursor" aria-hidden="true">
      <i class="c-tl" data-dx="-1" data-dy="-1"></i>
      <i class="c-tr" data-dx="1" data-dy="-1"></i>
      <i class="c-bl" data-dx="-1" data-dy="1"></i>
      <i class="c-br" data-dx="1" data-dy="1"></i>
    </div>
    <div class="nameplate" id="nameplate" aria-hidden="true">
      <Key label="Enter" pad="A" round />
      <span class="np-text"><span class="np-name" id="np-name"></span><span class="np-detail" id="np-detail"></span></span>
    </div>
  </main>

  <div class="target" id="target" aria-hidden="true">
    <div class="t-door"><Doorway /><span class="t-door-mouth"></span><span class="t-glow"></span></div>
  </div>

  <nav class="corners" aria-label="Menu">
    <div class="corner-group">
      <button type="button" class="corner" id="btn-settings" aria-keyshortcuts="S">
        <Key label="S">
          <svg viewBox="0 0 5 4"><path d="M0 0h5v1H0zM0 1.5h5v1H0zM0 3h5v1H0z"></path></svg>
        </Key>
        <svg class="c-icon" viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M0 1h9v1H0zM5 0h2v3H5zM0 4h9v1H0zM1 3h2v3H1zM0 7h9v1H0zM4 6h2v3H4z"></path>
        </svg>
      </button>
      <a class="corner" id="btn-about" href="/about/" aria-keyshortcuts="A">
        <Key label="A" pad="Y" round />
        <Doorway class="c-icon" />
        About
      </a>
    </div>
    <div class="corner-group">
      <button
        type="button"
        class="corner no-label"
        id="btn-search"
        aria-label={`Search ${current.filter.label}`}
        aria-controls="search"
        aria-expanded="false"
        aria-keyshortcuts="/"
      >
        <Key label="/">
          <svg viewBox="0 0 5 4"><path d="M0 0h3v1H0zM0 1h1v1H0zM2 1h3v1H2zM0 2h3v1H0zM4 2h1v1H4zM2 3h3v1H2z"></path></svg>
        </Key>
        <svg class="c-icon" viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M1 0h4v1H1zM0 1h1v4H0zM5 1h1v4H5zM1 5h4v1H1zM5 5h2v2H5zM7 7h2v2H7z"></path>
        </svg>
      </button>
      <a
        class="corner no-label"
        id="btn-inspect"
        href={selGame ? gameUrl(selGame) : current.filter.path}
        aria-label="Game info"
        aria-keyshortcuts="I"
      >
        <Key label="I" pad="X" round />
        <svg class="c-icon" viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M2 0h5v1H2zM1 1h1v1H1zM7 1h1v1H7zM0 2h1v5H0zM8 2h1v5H8zM1 7h1v1H1zM7 7h1v1H7zM2 8h5v1H2zM4 2h1v1H4zM4 4h1v3H4z"></path>
        </svg>
      </a>
    </div>
  </nav>

  <p class="pad-hint" id="pad-hint" hidden>
    <svg viewBox="0 0 13 8" shape-rendering="crispEdges" aria-hidden="true"></svg>
    <span>Controller? Tap the screen.</span>
  </p>
</div>

<div class="blackout" id="blackout" hidden>
  <div class="bo-inner">
    <Doorway />
    <p class="bo-line">Opening <span id="bo-name"></span><span class="bo-dots"></span></p>
    <button type="button" class="bo-back" id="bo-back" hidden><Key label="Esc" pad="B" round />Back to the menu</button>
  </div>
</div>

{
  rows.map((row) => (
    <template id={`slots-${row.filter.key}`}>
      {row.list.map((game, i) => <Slot game={game} index={i} />)}
    </template>
  ))
}

<SettingsCard />
<AboutCard open={open === 'about'} />
{
  games.map((game) => (
    <Fragment>
      <InspectCard game={game} open={open === 'inspect' && game.id === selected} />
      <GateCard game={game} own={open === 'inspect' && game.id === selected} />
    </Fragment>
  ))
}
<div class="sr-only" aria-live="polite" id="live"></div>

<script>
  import '../scripts/launcher';
</script>
