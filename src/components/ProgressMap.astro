---
// A Dreamport's progress map, under its two numbers: a rectangle for each function of the original, green when it
// counts toward code ported, and a block for each part of the game, green once it's proven (src/lib/progress-map.mjs).
// It's the picture at /dreamports/<game>-dreamport/progress.svg, which every page's card loads only when it's shown,
// without the badges at its top, as the two numbers are just above. It opens the picture whole.
import type { MapView } from '../lib/dreamports';

interface Props {
  map: MapView;
}

const { src, alt, width, height, badges } = Astro.props.map;
---

<a class="pmap" href={src} style={`aspect-ratio: ${width} / ${height - badges}`}>
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" style={`margin-top: ${(-badges / width) * 100}%`} />
</a>
