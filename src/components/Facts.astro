---
// A box of facts about a game, each a line of text, a link, the ways to play as icons, or a list of
// links. Whatever the box puts first, such as a Dreamport's two numbers, goes in its slot, and whatever it puts
// last, such as the game's parts, in its "after" slot.
import PixelIcon from './PixelIcon.astro';
import type { Fact } from '../lib/dreamports';

interface Props {
  facts: Fact[];
  id: string;
  heading: string;
}

const { facts, id, heading } = Astro.props;
const CONTROLS = {
  keyboard: { icon: 'keyboard', name: 'Keyboard' },
  controller: { icon: 'gamepad', name: 'Controller' },
  touch: { icon: 'pointer', name: 'Touch' },
} as const;
---

<section class="facts" aria-labelledby={id}>
  <h3 id={id}>{heading}</h3>
  <slot />
  <dl>
    {
      facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>
            {fact.controls ? (
              <span class="ctl">
                {fact.controls.map((c) => (
                  <span class="ctl-i" title={CONTROLS[c].name}>
                    <PixelIcon name={CONTROLS[c].icon} />
                    <span class="sr-only">{CONTROLS[c].name}</span>
                  </span>
                ))}
              </span>
            ) : fact.items ? (
              <ul class="fact-items">
                {fact.items.map((item) => (
                  <li>
                    {item.href ? <a href={item.href}>{item.value}</a> : item.value}
                    {item.note && <span class="fact-note">{item.note}</span>}
                  </li>
                ))}
              </ul>
            ) : fact.href ? (
              <a href={fact.href}>{fact.value}</a>
            ) : (
              fact.value
            )}
            {fact.note && <span class="fact-note">{fact.note}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  <slot name="after" />
</section>
