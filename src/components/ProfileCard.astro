---
// The player's profile, as a full screen in the menu's place: making one or signing in with a
// passkey, then the achievements it keeps. src/scripts/profile.ts fills it, and it needs
// JavaScript, like passkeys.
import { getEntry } from 'astro:content';
import ViewBar from './ViewBar.astro';
import { MINIMUM_AGE, PLAYABLE } from '../lib/players';
import { gameUrl, pageTitle } from '../lib/site';

interface Props {
  // Open when the page loads, at /profile/.
  open?: boolean;
}

const { open = false } = Astro.props;
const Title = open ? 'h1' : 'h2';
// each game's name and page, by the name in its address under /play/
const games: Record<string, { title: string; href: string }> = {};
for (const [play, { entry }] of Object.entries(PLAYABLE)) {
  const game = await getEntry('games', entry);
  if (game) games[play] = { title: game.data.title, href: gameUrl(game) };
}
---

<dialog
  class="card view card-profile"
  id="card-profile"
  data-card="profile"
  data-path="/profile/"
  data-title={pageTitle('Profile')}
  data-games={JSON.stringify(games)}
  aria-labelledby="profile-title"
  open={open}
>
  <div class="card-body">
    <Title class="card-title" id="profile-title">Profile</Title>
    <div class="pf-body">
      <p class="pf-status" id="pf-status" role="status" aria-live="polite"></p>

      <div class="pf-state" id="pf-out" hidden>
        <p class="pf-lead">
          Keep the achievements you earn in Dreamports, on any device. Your profile is private unless you make it public.
          There’s no password and no email: you sign in with a passkey, which your device or password manager keeps.
        </p>
        <form class="pf-new" id="pf-new" novalidate>
          <div class="set-list">
            <div class="set-row pf-field">
              <div class="set-text">
                <label class="set-label" for="pf-name">Player name</label>
                <span class="set-desc" id="pf-name-desc">3 to 20 letters, numbers, dashes or underscores. Others see it only on a public profile.</span>
              </div>
              <input
                class="pf-input"
                id="pf-name"
                name="name"
                type="text"
                minlength="3"
                maxlength="20"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                enterkeyhint="done"
                aria-describedby="pf-name-desc"
              />
            </div>
          </div>
          <label class="check">
            <input type="checkbox" id="pf-age" />
            <span>I’m {MINIMUM_AGE} or older</span>
          </label>
          <button type="submit" class="btn pf-create" id="pf-create">Make my profile</button>
        </form>
        <div class="set-list">
          <div class="set-row">
            <div class="set-text">
              <span class="set-label">Already have a profile?</span>
              <span class="set-desc">Sign in with its passkey, from this device or your phone.</span>
            </div>
            <button type="button" class="btn btn--alt" id="pf-sign-in">Sign in</button>
          </div>
        </div>
      </div>

      <div class="pf-state" id="pf-in" hidden>
        <p class="pf-since" id="pf-since"></p>
        <div class="set-list">
          <div class="set-row">
            <div class="set-text">
              <span class="set-label" id="pf-public-label">Public profile</span>
              <span class="set-desc" id="pf-public-desc"></span>
            </div>
            <button type="button" class="switch" role="switch" aria-checked="false" aria-labelledby="pf-public-label" aria-describedby="pf-public-desc" id="pf-public" autofocus>
              <span class="switch-track"><span class="switch-knob"></span></span>
            </button>
          </div>
        </div>
        <h3 class="pf-heading">Achievements</h3>
        <div class="pf-games" id="pf-games"></div>
        <div class="set-list">
          <div class="set-row">
            <div class="set-text">
              <span class="set-label">Passkeys</span>
              <span class="set-desc" id="pf-passkeys"></span>
            </div>
            <button type="button" class="btn btn--alt" id="pf-add">Add a passkey</button>
          </div>
        </div>
        <p class="card-note">
          <a class="linkish" href="/api/me/data" download>Download my data</a> ·{' '}
          <button type="button" class="linkish" id="pf-sign-out">Sign out</button> ·{' '}
          <button type="button" class="linkish" id="pf-delete">Delete my profile</button> ·{' '}
          <a class="linkish" href="/about/#privacy">Your privacy</a>
        </p>
        <div class="set-list pf-confirm" id="pf-confirm" hidden>
          <div class="set-row">
            <div class="set-text">
              <span class="set-label">Delete your profile?</span>
              <span class="set-desc">Its name, passkeys and achievements go for good. What the games keep on this device stays.</span>
            </div>
            <div class="pf-buttons">
              <button type="button" class="btn btn--alt" id="pf-keep">Keep it</button>
              <button type="button" class="btn" id="pf-delete-yes">Delete</button>
            </div>
          </div>
        </div>
      </div>

      <noscript><p class="pf-lead">Profiles need JavaScript, like the passkeys they use.</p></noscript>
    </div>
  </div>
  <ViewBar href="/" />
</dialog>
