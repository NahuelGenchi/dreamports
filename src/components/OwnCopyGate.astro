---
import Star from './Star.astro';
import type { Game } from '../lib/site';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const { text, confirm, links, note } = game.data.ownCopy;
const downloads = links.every((link) => link.icon === 'download');
const lockedNote = downloads ? 'tick the box to unlock the downloads.' : 'tick the box to unlock play.';
const nudgeNote = downloads ? 'tick the box first, then download.' : 'tick the box first, then press play.';
const checkId = `own-${game.id}`;
---

<section id="play" class="gate" aria-labelledby="play-title">
  <h2 id="play-title" class="box-title"><Star /><span>before you play</span></h2>
  <p class="gate-text">{text}</p>
  {/* Without JavaScript the browser itself refuses to follow a link until the box is ticked. */}
  <form
    class="gate-form"
    method="get"
    action={links[0].href}
    data-game={game.id}
    data-locked-note={lockedNote}
    data-nudge-note={nudgeNote}
  >
    <label class="check" for={checkId}>
      <input type="checkbox" id={checkId} required />
      <span>{confirm}</span>
    </label>
    <div class="gate-actions">
      <div class="gate-buttons">
        {
          links.map((link, index) => (
            <button
              type="submit"
              class:list={['btn', index > 0 && 'btn--alt']}
              formaction={link.href}
              aria-describedby="gate-note"
            >
              <svg class="icon-lock" viewBox="0 0 8 7" width="16" height="14" fill="currentColor" aria-hidden="true">
                <path d="M2 0h4v1H2zM1 1h1v2H1zM6 1h1v2H6zM0 3h8v1H0zM0 4h3v2H0zM5 4h3v2H5zM0 6h8v1H0z" />
              </svg>
              <span class="icon-go" aria-hidden="true">{link.icon === 'download' ? '↓' : '▶'}</span>
              {link.label}
            </button>
          ))
        }
      </div>
      <p id="gate-note" class="gate-note" aria-live="polite">
        <span class="note-locked">{lockedNote}</span>
        <span class="note-open">{note}</span>
      </p>
    </div>
  </form>
</section>

<script>
  // Remembers the tick for this tab only, and opens links without adding "?" to them.
  for (const form of document.querySelectorAll<HTMLFormElement>('form.gate-form')) {
    const box = form.querySelector<HTMLInputElement>('input[type="checkbox"]')!;
    const buttons = form.querySelectorAll<HTMLButtonElement>('button[type="submit"]');
    const lockedNote = form.querySelector<HTMLElement>('.note-locked')!;
    const key = `dreamports:own:${form.dataset.game}`;

    const sync = () => {
      for (const button of buttons) button.setAttribute('aria-disabled', String(!box.checked));
      try {
        if (box.checked) sessionStorage.setItem(key, '1');
        else sessionStorage.removeItem(key);
      } catch {}
    };

    try {
      if (sessionStorage.getItem(key) === '1') box.checked = true;
    } catch {}
    sync();

    box.addEventListener('change', () => {
      lockedNote.textContent = form.dataset.lockedNote ?? '';
      sync();
    });

    box.addEventListener('invalid', (event) => {
      event.preventDefault();
      lockedNote.textContent = form.dataset.nudgeNote ?? '';
      box.focus();
    });

    form.addEventListener('submit', (event) => {
      const button = event.submitter;
      if (!box.checked || !(button instanceof HTMLButtonElement)) return;
      event.preventDefault();
      window.location.assign(button.formAction);
    });
  }
</script>
