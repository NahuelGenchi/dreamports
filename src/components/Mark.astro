---
// The Dreamports mark (src/lib/mark.ts): the leaping dolphin with its star and drops of water, or with `alone` the
// dolphin by itself, for small sizes. Each mark on a page needs its own `id`, as its runs of colour are found by id.
import { DOLPHIN, MARK } from '../lib/mark';

interface Props {
  id?: string;
  alone?: boolean;
  class?: string;
}

const { id = 'mark', alone = false, class: className } = Astro.props;
const art = alone ? DOLPHIN : MARK;
---

<svg
  class:list={['mark', className]}
  viewBox={art.viewBox}
  aria-hidden="true"
  focusable="false"
  set:html={art.svg.replaceAll('ID-', `${id}-`)}
/>
