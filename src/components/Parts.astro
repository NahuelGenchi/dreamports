---
// The parts of a Dreamport's game, under its numbers: a block for each, filled once a recording has proven it, and
// for a part with a recording, its frames and what they found.
import type { PartView } from '../lib/dreamports';

interface Props {
  parts: PartView[];
  id: string;
}

const { parts, id } = Astro.props;
const proven = parts.filter((part) => part.proven).length;
---

{
  parts.length > 0 && (
    <div class="parts">
      <p class="meter-label" id={id}>
        The game’s parts, {proven} of {parts.length} proven
      </p>
      <ul aria-labelledby={id}>
        {parts.map((part) => (
          <li class:list={[part.proven && 'is-proven']}>
            <i aria-hidden="true" />
            <span>
              {part.href ? <a href={part.href}>{part.name}</a> : part.name}
              <span class="sr-only">{part.proven ? ', proven' : ', not proven yet'}</span>
              {part.note && <span class="fact-note">{part.note}</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}
