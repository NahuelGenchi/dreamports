---
// Gameplay proven, the second of a Dreamport's numbers, as one line that opens to what proves the numbers: every part of
// the game, a block for each, filled once a recording has proven it, and links to the evidence. A part with a
// recording links to it, and one that isn't proven yet says where it stands.
import Meter from './Meter.astro';
import type { Measure, PartView } from '../lib/dreamports';

interface Props {
  measure: Measure;
  parts: PartView[];
  evidence: { value: string; href: string }[];
}

const { measure, parts, evidence } = Astro.props;
---

<details class="parts">
  <summary class="parts-meter"><Meter measure={measure} /></summary>
  {
    parts.length > 0 && (
      <ul>
        {parts.map((part) => (
          <li class:list={[part.proven && 'is-proven']}>
            <i aria-hidden="true" />
            <span>
              {part.href ? <a href={part.href}>{part.name}</a> : part.name}
              <span class="sr-only">{part.proven ? ', proven' : ', not proven yet'}</span>
              {part.note && <span class="fact-note">{part.note}</span>}
            </span>
          </li>
        ))}
      </ul>
    )
  }
  <p class="parts-links">
    {evidence.map((link, i) => <>{i > 0 && ' · '}<a href={link.href}>{link.value}</a></>)}
  </p>
</details>
