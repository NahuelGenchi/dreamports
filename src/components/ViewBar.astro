---
// The bar along the bottom of a view, where the menu's corner buttons stand: the way back.
import Key from './Key.astro';

interface Props {
  // where Back goes without JavaScript; settings, which needs JavaScript, has none
  href?: string;
}

const { href } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<div class="view-bar">
  <Tag class="corner view-back" href={href} type={href ? undefined : 'button'} data-close>
    <Key label="Esc" pad="B" round />
    <svg class="c-icon" viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M3 1h1v1H3zM2 2h2v1H2zM1 3h8v1H1zM0 4h9v1H0zM1 5h8v1H1zM2 6h2v1H2zM3 7h1v1H3z"></path>
    </svg>
    Back
  </Tag>
</div>
