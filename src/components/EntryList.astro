---
import { gameUrl, sectionFor, type Game } from '../lib/site';

interface Props {
  games: Game[];
  level?: 2 | 3;
}

const { games, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

{
  games.map((game) => (
    <article class="entry">
      <p class="label">
        <span class="kind">{sectionFor(game.data.kind).label}</span> · {game.data.platform}
      </p>
      <Heading class="entry-title">
        <a href={gameUrl(game)}>{game.data.title}</a>
      </Heading>
      <p class="entry-summary">{game.data.summary}</p>
    </article>
  ))
}
