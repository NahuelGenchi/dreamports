---
// A Dreamport's page in the Make row, in the menu's place (#142), with only what a newcomer needs to help make it:
// its cover and the way to play it as it is, which opens its page in the Dreamports row; its name and a block for
// each part of the game, filled once a recording proves it, with one line on where it stands; and Help make it,
// the sentence to paste into a coding agent, which copies when pressed, how many pieces are free to take, and a link
// to its game's issue, to talk about it; and its latest step, with the earlier ones folded. Who leads it, what waits
// for review and the code map stay on GitHub. It comes from the entry and the proof/ folder, like the game's page,
// and its pieces and steps from GitHub as the site is built (src/lib/making.ts).
import Tile from './Tile.astro';
import ViewBar from './ViewBar.astro';
import { MAKE_GUIDE_URL, gameUrl, makeUrl, pageTitle, type Game } from '../lib/site';
import { makeView } from '../lib/dreamports';
import type { Making } from '../lib/making';

interface Props {
  game: Game;
  // Open when the page loads, on its own address.
  open?: boolean;
  // what GitHub says about it, when GitHub could be read for this build
  github?: Making;
}

const { game, open = false, github } = Astro.props;
if (game.data.kind !== 'dreamport') throw new Error(`${game.id} has no page in the Make row: only Dreamports are made here.`);
const { data } = game;
const view = makeView(data, github);
const [latest, ...earlier] = view.steps;
const id = game.id;
const Title = open ? 'h1' : 'h2';
const Heading = open ? 'h2' : 'h3';
const caption = (i: number, part: { name: string; proven: boolean }) =>
  `Part ${i + 1}: ${part.name}. ${part.proven ? 'Proven, every frame matches the original.' : 'Not proven yet.'}`;
---

<dialog
  class="card view card-make"
  id={`make-${id}`}
  data-card="make"
  data-game={id}
  data-filter="make"
  data-path={makeUrl(data.game)}
  data-title={pageTitle(`${data.title} · Make`)}
  aria-labelledby={`mk-title-${id}`}
  open={open}
>
  <div class="inspect make">
    <div class="ins-show">
      <div class="show-wrap">
        <i class="glow" style={`--g: ${data.glow}`}></i>
        <div class="show-tile"><Tile game={game} lazy={!open} /></div>
      </div>
      <a class="btn btn--alt mk-play" href={gameUrl(game)} data-page>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M4 2h2v2h2v2h2v2H8v2H6v2H4zM10 6h2v4h-2z" />
        </svg>
        Play it as it is
      </a>
    </div>
    <div class="ins-text" tabindex="0">
      <Title class="ins-title mk-title" id={`mk-title-${id}`}>{data.title}</Title>
      <div class="mk-parts" role="group" aria-label="The game’s parts" data-roving>
        {
          view.parts.map((part, i) => (
            <button
              type="button"
              class:list={['mk-part', part.proven && 'is-proven']}
              aria-pressed="false"
              aria-label={caption(i, part)}
              tabindex={i === 0 ? undefined : -1}
              data-caption={caption(i, part)}
            />
          ))
        }
      </div>
      {/* each block says the same as its line, so the line itself needn't be read out */}
      <p class="mk-caption" data-summary={view.summary}>{view.summary}</p>
      <section class="mk-help" aria-labelledby={`mk-help-${id}`}>
        <Heading id={`mk-help-${id}`}>Help make it</Heading>
        <p>
          Paste this into a <a href={MAKE_GUIDE_URL}>coding agent</a>, such as Claude Code or Codex. It sets everything
          up and guides you, one step at a time.
        </p>
        <button type="button" class="mk-copy" data-copy={view.prompt} aria-label={`Copy: ${view.prompt}`} autofocus>
          {view.prompt}
          <svg class="mk-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path class="i-copy" fill-rule="evenodd" d="M5 1h10v10h-2V3H5zM1 5h10v10H1zM3 7v6h6V7z" />
            <path class="i-done" d="M2 7h2v2H2zM4 9h2v2H4zM6 11h2v2H6zM8 9h2v2H8zM10 7h2v2h-2zM12 5h2v2h-2zM14 3h2v2h-2z" />
          </svg>
        </button>
        <noscript><p class="mk-line">{view.prompt}</p></noscript>
        <p class="mk-talk">
          {view.free && `${view.free.line} `}<a href={view.talk}>Talk about it on GitHub ↗</a>
        </p>
      </section>
      {
        latest && (
          <section class="mk-steps" aria-labelledby={`mk-steps-${id}`}>
            <Heading class="mk-label" id={`mk-steps-${id}`}>Latest step</Heading>
            <p class="mk-step">{latest.title}</p>
            <p class="mk-when">
              <time datetime={latest.merged}>{latest.date}</time> ·{' '}
              <a href={latest.url} aria-label={`See it on GitHub: ${latest.title}`}>See it ↗</a>
            </p>
            {earlier.length > 0 && (
              <details class="mk-earlier">
                <summary>
                  <svg viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
                    <path d="M2 0h2v2h2v2h2v2H6v2H4v2H2z" />
                  </svg>
                  Earlier steps ({earlier.length})
                </summary>
                <ol>
                  {earlier.map((step) => (
                    <li>
                      <span class="mk-step">{step.title}</span>
                      <span class="mk-when">
                        <time datetime={step.merged}>{step.date}</time> ·{' '}
                        <a href={step.url} aria-label={`See it on GitHub: ${step.title}`}>See it ↗</a>
                      </span>
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </section>
        )
      }
    </div>
  </div>
  <ViewBar href="/make/" />
</dialog>
