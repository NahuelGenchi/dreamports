---
// A game's own page: the menu, on that game, with its card open.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Launcher from '../../components/Launcher.astro';
import { filterFor, getGames, sectionFor, type Game } from '../../lib/site';

export const getStaticPaths = (async () => {
  const games = await getGames();
  return games.map((game) => ({
    params: { section: sectionFor(game.data.kind).path, slug: game.id },
    props: { game },
  }));
}) satisfies GetStaticPaths;

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<Base title={game.data.title} description={game.data.summary}>
  <Launcher filter={filterFor(game.data.kind).key} selected={game.id} open="inspect" />
</Base>
