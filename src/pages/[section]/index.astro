---
// The older addresses for each kind of game, /dreamports/, /external-ports/ and /other-games/,
// keep working: each shows the menu on the filter that holds its games.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Launcher from '../../components/Launcher.astro';
import { SECTIONS, filterFor, type Section } from '../../lib/site';

export const getStaticPaths = (() =>
  SECTIONS.map((section) => ({ params: { section: section.path }, props: { section } }))) satisfies GetStaticPaths;

interface Props {
  section: Section;
}

const { section } = Astro.props;
const filter = filterFor(section.kind);
---

<Base title={section.title} description={section.lead} canonical={filter.path}>
  <Launcher filter={filter.key} />
</Base>
