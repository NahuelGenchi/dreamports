---
import Base from '../layouts/Base.astro';
import Doorway from '../components/Doorway.astro';
---

<Base title="page not found" description="this page isn’t here.">
  <main class="lost">
    <Doorway scale={4} />
    <h1>nothing behind this door.</h1>
    <p>this page isn’t here. it may have moved, or the link may have a typo.</p>
    <a class="btn" href="/"><span aria-hidden="true">←</span> back to the menu</a>
  </main>
</Base>
