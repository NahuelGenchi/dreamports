---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
---

<Base title="Page not found" description="It may have moved, or the link may have a typo.">
  <main class="lost">
    <Mark />
    <h1>Nothing here.</h1>
    <p>It may have moved, or the link may have a typo.</p>
    <a class="btn" href="/"><span aria-hidden="true">←</span> Menu</a>
  </main>
  <script>
    import '../scripts/controls';
    import { showLogoKept } from '../scripts/mark';
    showLogoKept();
  </script>
</Base>
