{
  // The Worker runs on Cloudflare, not in a browser, so it has its own types: `npm run check` checks it
  // with these.
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["./*.ts", "../src/lib/players.ts"]
}
