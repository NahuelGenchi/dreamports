+// Dreamports: the samples the console's audio interface takes by DMA, 8 at a time, handed on as they are: each a pair,
+// right and then left, highest byte first, turned to libretro's left and right in the computer's order. The interface
+// plays them at one of two rates, 108,000,000 over its divisor, 48,042.7 or 32,028.5 a second on a GameCube, which
+// whoever runs the core is told each time it changes. Sound a game streams from its disc isn't among them yet.
+void PushConsoleSamples(const short* samples, unsigned int num_samples, unsigned int rate_divisor)
+{
+  static unsigned int told_divisor = 0;
+  static std::vector<int16_t> pairs;
+  if (!batch_cb || !samples || !num_samples)
+    return;
+  if (rate_divisor && rate_divisor != told_divisor)
+  {
+    told_divisor = rate_divisor;
+    retro_system_av_info info;
+    retro_get_system_av_info(&info);
+    info.timing.sample_rate = 108000000.0 / rate_divisor;
+    Libretro::environ_cb(RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO, &info);
+  }
+  pairs.resize(static_cast<size_t>(num_samples) * 2);
+  for (unsigned int i = 0; i < num_samples; i++)
+  {
+    const uint16_t right = static_cast<uint16_t>(samples[i * 2]), left = static_cast<uint16_t>(samples[i * 2 + 1]);
+    pairs[i * 2] = static_cast<int16_t>(static_cast<uint16_t>((left >> 8) | (left << 8)));
+    pairs[i * 2 + 1] = static_cast<int16_t>(static_cast<uint16_t>((right >> 8) | (right << 8)));
+  }
+  batch_cb(pairs.data(), num_samples);
+}
