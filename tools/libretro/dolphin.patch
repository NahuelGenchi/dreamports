+// Dreamports: one function of the console's program run by itself on Dolphin's own interpreter, the processor `prove`
+// runs a game on, for the function check (tools/libretro/host.c, its call mode). Whoever runs the core has booted a
+// program and stopped between frames; it gives the registers a call starts with, and the interpreter runs an
+// instruction at a time from `pc` until the processor comes back to `sentinel`, which the link register is set to,
+// runs `most` instructions, meets an exception, or reaches what the check can't follow. No time passes for the rest of
+// the console meanwhile, the hardware's registers are memory of their own (Core/PowerPC/MMU.cpp), and the data cache is
+// written back to memory and emptied as the call ends, so what the function stored is in memory either way and the
+// next call starts as this one did.
+//
+// `state` holds, in 32-bit words: the 32 general registers; the 32 floating-point registers' first halves, then their
+// second halves, two words each, the high one first; CR, XER, LR, CTR, FPSCR and the eight GQRs. It's read as the call
+// starts and written as it ends. `hardware` is the 64 KB of the hardware's registers, read and written. `ran` is told
+// of each instruction as it runs: its address, and for a conditional branch 1 when it went to its target and 2 when it
+// went on past it; `read` of each read: its address, how many bytes and the value. Returns how the call ended: 0 it
+// came back, 1 it ran out of instructions, 2 an exception, with `detail` the exceptions' bits, 3 it reached what the
+// check can't follow, with `detail` the address; and `at` where it was, `steps` how many instructions ran, and
+// `used` whether it read or wrote the hardware's registers.
+extern "C" RETRO_API int dreamports_call(uint32_t pc, uint32_t sentinel, uint32_t most, uint32_t* state,
+                                         uint8_t* hardware, void (*ran)(uint32_t, uint32_t),
+                                         void (*read)(uint32_t, uint32_t, uint64_t), uint32_t* detail,
+                                         uint32_t* at, uint32_t* steps, uint32_t* used)
+{
+  auto& system = Core::System::GetInstance();
+  auto& ppc = system.GetPPCState();
+  auto& memory = system.GetMemory();
+  auto& mmu = system.GetMMU();
+  auto& interpreter = system.GetInterpreter();
+  // the processor's state as the program left it after its frames, which every call starts from: its machine state,
+  // its special registers and its segments, so that what one call did to them, or an exception it met, isn't the next
+  // one's start
+  static bool kept = false;
+  static u32 kept_msr, kept_spr[1024], kept_sr[16];
+  if (!kept)
+  {
+    kept = true;
+    kept_msr = ppc.msr.Hex;
+    std::memcpy(kept_spr, ppc.spr, sizeof kept_spr);
+    std::memcpy(kept_sr, ppc.sr.data(), sizeof kept_sr);
+  }
+  ppc.msr.Hex = kept_msr;
+  std::memcpy(ppc.spr, kept_spr, sizeof kept_spr);
+  std::memcpy(ppc.sr.data(), kept_sr, sizeof kept_sr);
+  mmu.DBATUpdated();
+  mmu.IBATUpdated();
+  for (int i = 0; i < 32; i++)
+    ppc.gpr[i] = state[i];
+  for (int i = 0; i < 32; i++)
+  {
+    ppc.ps[i].SetPS0((u64(state[32 + i * 2]) << 32) | state[33 + i * 2]);
+    ppc.ps[i].SetPS1((u64(state[96 + i * 2]) << 32) | state[97 + i * 2]);
+  }
+  ppc.cr.Set(state[160]);
+  ppc.SetXER(UReg_XER(state[161]));
+  LR(ppc) = sentinel;
+  CTR(ppc) = state[163];
+  ppc.fpscr.Hex = state[164];
+  for (int i = 0; i < 8; i++)
+    ppc.spr[SPR_GQR0 + i] = state[165 + i];
+  // the caches emptied, as memory is what the check just gave it, and the floating-point unit on, as a game's code
+  // runs with it
+  ppc.dCache.Reset();
+  ppc.iCache.Reset(system.GetJitInterface());
+  ppc.msr.FP = 1;
+  ppc.pc = pc;
+  ppc.npc = pc + 4;
+  ppc.Exceptions = 0;
+  std::memcpy(DreamportsCall.hardware, hardware, sizeof DreamportsCall.hardware);
+  DreamportsCall.used_hardware = false;
+  DreamportsCall.elsewhere = false;
+  DreamportsCall.read = read;
+  DreamportsCall.on = true;
+  int end = 1;
+  uint32_t count = 0;
+  *detail = 0;
+  while (count < most)
+  {
+    if (ppc.pc == sentinel)
+    {
+      end = 0;
+      break;
+    }
+    const u32 here = ppc.pc;
+    const u32 word = mmu.Read_Opcode(here);
+    interpreter.SingleStepInner();
+    count++;
+    const u32 op = word >> 26, xo = (word >> 1) & 0x3FF;
+    const bool conditional = (op == 16 || (op == 19 && (xo == 16 || xo == 528))) && ((word >> 21) & 0x14) != 0x14;
+    if (ran)
+      ran(here, conditional ? (ppc.pc == here + 4 ? 2 : 1) : 0);
+    if (DreamportsCall.elsewhere)
+    {
+      end = 3;
+      *detail = DreamportsCall.elsewhere_at;
+      ppc.pc = here;
+      break;
+    }
+    if (ppc.Exceptions != 0)
+    {
+      end = 2;
+      *detail = ppc.Exceptions;
+      ppc.Exceptions = 0;
+      ppc.pc = here;
+      break;
+    }
+  }
+  DreamportsCall.on = false;
+  DreamportsCall.read = nullptr;
+  *at = ppc.pc;
+  *steps = count;
+  *used = DreamportsCall.used_hardware ? 1 : 0;
+  ppc.dCache.FlushAll(memory);
+  ppc.dCache.Reset();
+  std::memcpy(hardware, DreamportsCall.hardware, sizeof DreamportsCall.hardware);
+  for (int i = 0; i < 32; i++)
+    state[i] = ppc.gpr[i];
+  for (int i = 0; i < 32; i++)
+  {
+    state[32 + i * 2] = u32(ppc.ps[i].PS0AsU64() >> 32);
+    state[33 + i * 2] = u32(ppc.ps[i].PS0AsU64());
+    state[96 + i * 2] = u32(ppc.ps[i].PS1AsU64() >> 32);
+    state[97 + i * 2] = u32(ppc.ps[i].PS1AsU64());
+  }
+  state[160] = ppc.cr.Get();
+  state[161] = ppc.GetXER().Hex;
+  state[162] = LR(ppc);
+  state[163] = CTR(ppc);
+  state[164] = ppc.fpscr.Hex;
+  for (int i = 0; i < 8; i++)
+    state[165 + i] = ppc.spr[SPR_GQR0 + i];
+  return end;
+}
