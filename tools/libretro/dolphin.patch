+// Dreamports: a picture of the software renderer's, handed to whoever runs the core: the stretch of the texture that's
+// shown, in the order libretro's XRGB8888 has a pixel's colours, where the texture has red first
+void ShowSoftwareImage(const u8* data, u32 texture_width, const MathUtil::Rectangle<int>& shown)
+{
+  static std::vector<u32> picture;
+  const int width = shown.GetWidth(), height = shown.GetHeight();
+  if (!video_cb || width <= 0 || height <= 0)
+    return;
+  picture.resize(static_cast<size_t>(width) * height);
+  for (int y = 0; y < height; y++)
+  {
+    const u8* row = data + (static_cast<size_t>(shown.top + y) * texture_width + shown.left) * 4;
+    for (int x = 0; x < width; x++)
+    {
+      picture[static_cast<size_t>(y) * width + x] =
+          0xFF000000u | (u32(row[x * 4]) << 16) | (u32(row[x * 4 + 1]) << 8) | row[x * 4 + 2];
+    }
+  }
+  video_cb(picture.data(), width, height, static_cast<size_t>(width) * 4);
+  UpdateActiveConfig();
+}
