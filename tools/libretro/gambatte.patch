+/* Dreamports: the processor tells the tools' program of every instruction (cpu.cpp). retro_dreamports_ran_sm83 gives
+ * the function to tell, or none. Its name starts as libretro's own do, as those are the only names this core lets out
+ * (link.T). */
+extern void (*DreamportsRan)(unsigned long pc, unsigned long place, unsigned long op, unsigned long fasp);
+static void (*dreamports_told)(uint32_t pc, uint32_t place, uint32_t op, uint32_t fasp);
+
+static void dreamports_ran(unsigned long pc, unsigned long place, unsigned long op, unsigned long fasp)
+{
+   dreamports_told((uint32_t)pc, (uint32_t)place, (uint32_t)op, (uint32_t)fasp);
+}
+
+extern "C" RETRO_API void retro_dreamports_ran_sm83(void (*told)(uint32_t, uint32_t, uint32_t, uint32_t))
+{
+   dreamports_told = told;
+   DreamportsRan   = told ? dreamports_ran : NULL;
+}
