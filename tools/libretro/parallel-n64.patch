diff --git a/mupen64plus-core/src/device/r4300/fpu.h b/mupen64plus-core/src/device/r4300/fpu.h
index 7691dcd..950145c 100644
--- a/mupen64plus-core/src/device/r4300/fpu.h
+++ b/mupen64plus-core/src/device/r4300/fpu.h
@@ -67,6 +67,46 @@ static __inline float  truncf(float x) { return (float)(int)x; }
 #define FCR31_FLAG_INVALIDOP_BIT UINT32_C(0x000040)
 
 
+/* Dreamports: on x86 the emulator has SSE make a result too small to be an ordinary number a zero of its sign, by
+ * the flush mode update_x86_rounding_mode gives it from FCR31 (cp1.c). A computer without SSE, as a Mac with Apple's
+ * chip, has nothing doing that, and kept the small number, so the same function came out otherwise there. Without SSE
+ * the same is done here, by the same rule, to the result of each operation SSE's mode flushes: a sum, a difference, a
+ * product, a quotient, a square root and a double made a float, and not an absolute value or a negation, which SSE
+ * makes with its logic and leaves as they are. A number given that is too small is used as it is, as the emulator
+ * leaves SSE's mode for those off (r4300_core.c). */
+#include "osal/preproc.h"
+#ifdef OSAL_SSE
+#define fpu_flush_float(fcr31, value) ((void)0)
+#define fpu_flush_double(fcr31, value) ((void)0)
+#else
+M64P_FPU_INLINE int fpu_flushes(uint32_t fcr31)
+{
+    return (fcr31 & 2) ? !(fcr31 & UINT32_C(0x1000000)) : 1;
+}
+
+M64P_FPU_INLINE void fpu_flush_float(uint32_t fcr31, float* value)
+{
+    uint32_t bits;
+    memcpy(&bits, value, sizeof bits);
+    if (fpu_flushes(fcr31) && (bits & UINT32_C(0x7F800000)) == 0 && (bits & UINT32_C(0x7FFFFF)) != 0)
+    {
+        bits &= UINT32_C(0x80000000);
+        memcpy(value, &bits, sizeof bits);
+    }
+}
+
+M64P_FPU_INLINE void fpu_flush_double(uint32_t fcr31, double* value)
+{
+    uint64_t bits;
+    memcpy(&bits, value, sizeof bits);
+    if (fpu_flushes(fcr31) && (bits & UINT64_C(0x7FF0000000000000)) == 0 && (bits & UINT64_C(0xFFFFFFFFFFFFF)) != 0)
+    {
+        bits &= UINT64_C(0x8000000000000000);
+        memcpy(value, &bits, sizeof bits);
+    }
+}
+#endif
+
