+
+// Dreamports: one function of a game's program at a time, run by the emulator's own interpreter, for the tools'
+// function check (tools/psp/twin.mjs). `in` holds the function's address, how many bytes long it is, how many
+// instructions it may run, the address it comes back to, the 32 registers with hi and lo, and how many places stop a
+// call, then each: the pairs of instructions the system writes its calls into. Each instruction runs as the
+// interpreter runs it, a branch with its delay slot. Before one that reads or writes memory, `noted` is told where and
+// how many bytes, and whether it reads (1) or writes (2), or the call ends there, as an exception, when the processor
+// has nothing there. `out` gets how the call ended (0 came back, 1 ran out of instructions, 2 met an exception, 3 went
+// where the check can't follow, 4 reached the system), where, the pc, how many instructions ran, and the registers;
+// `ran` a byte for each instruction of the function: 1 ran, 2 a branch there went to its target, 4 went on.
+extern "C" RETRO_API void dreamports_call(const uint32_t *in, uint32_t *out, uint8_t *ran, void (*noted)(uint32_t address, uint32_t bytes, uint32_t how)) {
+   MIPSState *m = currentMIPS;
+   const uint32_t address = in[0], span = in[1], limit = in[2], back = in[3], stopCount = in[38];
+   const uint32_t *stops = in + 39;
+   for (int i = 0; i < 32; i++)
+      m->r[i] = in[4 + i];
+   m->r[0] = 0;
+   m->hi = in[36];
+   m->lo = in[37];
+   m->pc = address;
+   m->nextPC = 0;
+   m->inDelaySlot = false;
+   const CoreState was = coreState;
+   coreState = CORE_RUNNING_CPU;
+   uint32_t end = 0, detail = 0, steps = 0;
+   for (;;) {
+      const uint32_t pc = m->pc;
+      if (pc == back && !m->inDelaySlot) { end = 0; break; }
+      if (steps >= limit) { end = 1; detail = pc; break; }
+      bool system = false;
+      for (uint32_t i = 0; i < stopCount && !system; i++)
+         system = pc == stops[i] || pc == stops[i] + 4;
+      if (system) { end = 4; detail = pc; break; }
+      if (!Memory::IsValidAddress(pc) || (pc & 3)) { end = 3; detail = pc; break; }
+      const MIPSOpcode op = Memory::Read_Instruction(pc, true);
+      const uint32_t word = op.encoding;
+      // a call of the system made by the game's own code
+      if ((word & 0xFC00003F) == 0x0000000C) { end = 4; detail = pc; break; }
+      const MIPSInfo info = MIPSGetInfo(op);
+      if (info & (IN_MEM | OUT_MEM)) {
+         const uint32_t opcode = word >> 26, base = m->r[(word >> 21) & 31];
+         uint32_t bytes = MIPSGetMemoryAccessSize(op), at = base + (int16_t)(word & 0xFFFF);
+         // the vector unit's loads and stores leave the offset's low two bits to say other things
+         if (opcode == 0x32 || opcode == 0x36 || opcode == 0x3A || opcode == 0x3E || opcode == 0x35 || opcode == 0x3D)
+            at = base + (int16_t)(word & 0xFFFC);
+         // a word or a quad moved in part reaches the whole of it
+         if (opcode == 0x22 || opcode == 0x26 || opcode == 0x2A || opcode == 0x2E) { at &= ~3u; bytes = 4; }
+         if (opcode == 0x35 || opcode == 0x3D) { at &= ~15u; bytes = 16; }
+         if (!bytes || !Memory::IsValidRange(at, bytes)) { end = 2; detail = at; break; }
+         if (noted) noted(at, bytes, (info & IN_MEM ? 1 : 0) | (info & OUT_MEM ? 2 : 0));
+      }
+      const bool slot = m->inDelaySlot;
+      MIPSInterpret(op);
+      steps++;
+      if (m->inDelaySlot && slot) {
+         m->pc = m->nextPC;
+         m->inDelaySlot = false;
+      }
+      if (pc >= address && pc - address < span) {
+         uint8_t &mark = ran[(pc - address) >> 2];
+         mark |= 1;
+         if (info & IS_CONDBRANCH)
+            mark |= !slot && m->inDelaySlot ? 2 : 4;
+      }
+      if (coreState != CORE_RUNNING_CPU) { end = 2; detail = pc; break; }
+   }
+   out[0] = end;
+   out[1] = detail;
+   out[2] = m->pc;
+   out[3] = steps;
+   for (int i = 0; i < 32; i++)
+      out[4 + i] = m->r[i];
+   out[36] = m->hi;
+   out[37] = m->lo;
+   m->inDelaySlot = false;
+   coreState = was;
+}
