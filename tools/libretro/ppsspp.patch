+// Dreamports: the sound list, everything a game gives the sound channels that decides its sound, hashed in the order
+// given (FNV-1a), with how many things that was: each block handed to a channel, as 'Q', the channel, its two volumes,
+// its format and how many samples, and 'S', the samples' bytes, and each block of 64 samples the console mixes, as
+// 'M' and the samples as they leave it. The frontend reads it as each frame ends and starts it again
+// (dreamports_sound_list). The kit in C hashes its own the same way (kit/psp/c/audio.c).
+uint32_t dreamportsSoundHash = 0x811C9DC5;
+uint32_t dreamportsSoundCount = 0;
+static void DreamportsSoundListed(u8 kind, const void *data, size_t length) {
+	const u8 *bytes = (const u8 *)data;
+	dreamportsSoundHash = (dreamportsSoundHash ^ kind) * 0x01000193;
+	for (size_t i = 0; i < length; i++)
+		dreamportsSoundHash = (dreamportsSoundHash ^ bytes[i]) * 0x01000193;
+	dreamportsSoundCount++;
+}
