+// Dreamports: what the tools' function check takes from play (tools/libretro/starts.h): each instruction as the
+// interpreter is about to run it, the processor's registers then, and the console's memory, the 2 MB of RAM and the
+// scratchpad and hardware's registers PCSX keeps together.
+extern void (*dreamports_reached)(u32 pc);
+
+void dreamports_watch_pc(void (*reached)(uint32_t pc))
+{
+   dreamports_reached = reached;
+}
+
+// the 32 registers, then hi and lo, as the function will find them: a load still waiting, as one in a call's delay
+// slot is, is given as it will land
+const uint32_t *dreamports_registers(uint32_t *next)
+{
+   static uint32_t words[34];
+   int i;
+   for (i = 0; i < 32; i++)
+      words[i] = psxRegs.GPR.r[i];
+   words[32] = psxRegs.GPR.n.hi;
+   words[33] = psxRegs.GPR.n.lo;
+#ifdef HANDLE_LOAD_DELAY
+   for (i = 0; i < 2; i++)
+      if (psxRegs.dloadReg[psxRegs.dloadSel ^ i])
+         words[psxRegs.dloadReg[psxRegs.dloadSel ^ i]] = psxRegs.dloadVal[psxRegs.dloadSel ^ i];
+#endif
+   words[0] = 0;
+   (void)next;
+   return words;
+}
+
+// memory 0 is the console's RAM from its first byte, and memory 1 the scratchpad and the hardware's registers, from
+// 0x1F800000
+const uint8_t *dreamports_memory(uint32_t memory, uint32_t address, uint32_t bytes)
+{
+   if (memory == 0 && psxRegs.ptrs.psxM && address + bytes <= 0x200000)
+      return psxRegs.ptrs.psxM + address;
+   if (memory == 1 && psxRegs.ptrs.psxH && address + bytes <= 0x10000)
+      return psxRegs.ptrs.psxH + address;
+   return NULL;
+}
+
+// how the function check lays out what it's given: 34 registers, and 515 pages of 4 KB, the RAM's 512, then the
+// scratchpad's 4 KB and the hardware's 8 KB
+struct dreamportsStartsMemory { uint32_t memory, address, pages, first; };
+static const struct dreamportsStartsMemory dreamportsStartsMemories[] = {
+   { 0, 0x00000000, 0x200, 0x000 }, { 1, 0x00000000, 0x001, 0x200 }, { 1, 0x00001000, 0x002, 0x201 },
+};
+
+const void *dreamports_starts_layout(uint32_t *words, uint32_t *memories)
+{
+   *words = 34;
+   *memories = sizeof dreamportsStartsMemories / sizeof dreamportsStartsMemories[0];
+   return dreamportsStartsMemories;
+}
+
