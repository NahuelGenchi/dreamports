+	// The draw list: everything the console has given the GS that decides its picture, hashed in the order given
+	// (FNV-1a), with how many things that was. The frontend reads it at each V-blank and starts it again.
+	uint32 m_drawListHash = 0x811C9DC5;
+	uint32 m_drawListCount = 0;
+	void AddToDrawList(const void* data, size_t length)
+	{
+		auto bytes = static_cast<const uint8*>(data);
+		for(size_t i = 0; i < length; i++)
+		{
+			m_drawListHash = (m_drawListHash ^ bytes[i]) * 0x01000193;
+		}
+		m_drawListCount++;
+	}
 
