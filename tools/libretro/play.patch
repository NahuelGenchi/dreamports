@@ -0,0 +1,44 @@
+// What the PlayStation 2 kit's sound chip (kit/ps2/c/spu2.c in Dreamports, copied beside this file when the tools
+// build the emulator) needs of the kit, for it to be built into the emulator in place of the emulator's own chip, so
+// the original and a Dreamport are mixed by the same code.
+
+#ifndef DREAMPORTS_PS2_KIT_H
+#define DREAMPORTS_PS2_KIT_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SPU2_IN_REFERENCE 1
+
+// memory that starts as zeros and is never given back
+static inline void* kit_alloc(size_t size)
+{
+	return calloc(1, size ? size : 1);
+}
+
+void spu2_write(uint32_t address, uint32_t value);
+uint32_t spu2_read(uint32_t address);
+uint32_t spu2_dma(int core, uint8_t* buffer, uint32_t block_size, uint32_t blocks, uint32_t direction);
+void spu2_block(void);
+int spu2_irq(void);
