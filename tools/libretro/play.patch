+static void DreamportsStamp(const fs::path& card, time_t now)
+{
+	std::error_code error;
+	if(!fs::exists(card, error)) return;
+	auto stamp = [now](const fs::path& path) {
+		std::error_code error;
+		auto hostTime = fs::last_write_time(path, error);
+		if(error) return;
+		auto found = g_dreamportsStamps.find(path.generic_string());
+		if(found == g_dreamportsStamps.end() || found->second.first != hostTime) g_dreamportsStamps[path.generic_string()] = {hostTime, now};
+	};
+	stamp(card);
+	for(const auto& element : fs::recursive_directory_iterator(card, error)) stamp(element.path());
+}
+
+static time_t DreamportsStampOf(const fs::path& path)
+{
+	auto found = g_dreamportsStamps.find(path.generic_string());
+	return found == g_dreamportsStamps.end() ? Dreamports::CLOCK_START : found->second.second;
