+//Dreamports: an instruction on the console's float rules. The FCSR it leaves is worked out first, from the operands as
+//they are, and then its result, which can be one of them
+static void DpFpu(CMipsJitter* codeGen, uint32 op, size_t a, size_t b, size_t dst)
+{
+	codeGen->PushCst(op);
+	codeGen->PushRel(a);
+	codeGen->PushRel(b);
+	codeGen->PushRel(offsetof(CMIPS, m_State.nCOP1A));
+	codeGen->PushRel(offsetof(CMIPS, m_State.nFCSR));
+	codeGen->Call(reinterpret_cast<void*>(&DpFpuFcsr), 5, Jitter::CJitter::RETURN_VALUE_32);
+	codeGen->PullRel(offsetof(CMIPS, m_State.nFCSR));
+
+	if(op == DP_CLEAR) return;
+	codeGen->PushCst(op);
+	codeGen->PushRel(a);
+	codeGen->PushRel(b);
+	codeGen->PushRel(offsetof(CMIPS, m_State.nCOP1A));
+	codeGen->Call(reinterpret_cast<void*>(&DpFpuResult), 4, Jitter::CJitter::RETURN_VALUE_32);
+	codeGen->PullRel(dst);
+}
+
+static void DpFpuCompareOp(CMipsJitter* codeGen, uint32 op, size_t a, size_t b)
+{
+	codeGen->PushCst(op);
+	codeGen->PushRel(a);
+	codeGen->PushRel(b);
+	codeGen->Call(reinterpret_cast<void*>(&DpFpuCompare), 3, Jitter::CJitter::RETURN_VALUE_32);
+}
