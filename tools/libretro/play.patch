+
+// What kind of branch ends a block, from the word of its branch and, on a vector unit, its delay slot's upper word: one
+// whose way the code alone decides, as BEQ with a register against itself, is no conditional branch, as `b` is written
+static uint32 DreamportsBranchKind(uint32 processor, uint32 word, uint32 delayUpper)
+{
+	uint32 op = word >> 26, rs = (word >> 21) & 0x1F, rt = (word >> 16) & 0x1F;
+	if(processor == Dreamports::PROCESSOR_VU0 || processor == Dreamports::PROCESSOR_VU1)
+	{
+		// IBEQ, IBNE, IBLTZ, IBGTZ, IBLEZ and IBGEZ, the lower instructions that branch on a condition
+		uint32 lower = word >> 25, it = (word >> 16) & 0x1F, is = (word >> 11) & 0x1F;
+		bool conditional = lower == 0x28 || lower == 0x29 || (lower >= 0x2C && lower <= 0x2F);
+		if(!conditional || (lower == 0x28 && it == is)) return 0;
+		return (delayUpper & 0x40000000) ? 3 : 1;
+	}
+	switch(op)
+	{
+	case 0x01:
+		// BLTZ, BGEZ, BLTZL, BGEZL, BLTZAL, BGEZAL, BLTZALL, BGEZALL: against zero itself, BGEZ always goes
+		if(rt > 0x13 || (rt > 0x03 && rt < 0x10)) return 0;
+		if(rs == 0 && (rt & 1)) return 0;
+		return (rt & 2) ? 2 : 1;
+	case 0x04: case 0x14: // BEQ, BEQL
+		if(rs == rt) return 0;
+		return op == 0x14 ? 2 : 1;
+	case 0x05: case 0x15: // BNE, BNEL
+		return op == 0x15 ? 2 : 1;
+	case 0x06: case 0x16: // BLEZ, BLEZL: zero is never more than zero
+		if(rs == 0) return 0;
+		return op == 0x16 ? 2 : 1;
+	case 0x07: case 0x17: // BGTZ, BGTZL
+		return op == 0x17 ? 2 : 1;
+	case 0x10: case 0x11: case 0x12: // BC0, BC1 and BC2, false or true, likely or not
+		if(rs != 0x08) return 0;
+		return (rt & 2) ? 2 : 1;
+	default:
+		return 0;
+	}
+}
+
+// The block being compiled, as the tools are told of it: its place in g_dreamportsBlocks, or ~0 when they aren't
+// watching it. Compile starts it again for each block
+static struct
+{
+	const CBasicBlock* block;
+	uint32 index;
+} g_dreamportsCompiling = {nullptr, ~0U};
+
+static uint32 DreamportsIndexOf(const CBasicBlock* compiling, CMIPS& context, uint32 begin, uint32 end, bool empty)
+{
+	if(g_dreamportsCompiling.block == compiling) return g_dreamportsCompiling.index;
+	g_dreamportsCompiling = {compiling, ~0U};
+	if(!Dreamports::g_blockRan || empty) return ~0U;
+	uint32 processor = 0;
+	while(processor < Dreamports::PROCESSORS && Dreamports::g_processors[processor] != &context) processor++;
+	if(processor == Dreamports::PROCESSORS) return ~0U;
+	bool vu = processor == Dreamports::PROCESSOR_VU0 || processor == Dreamports::PROCESSOR_VU1;
+	uint32 step = vu ? 8 : 4, count = vu ? ((end - 4 - begin) / 8 + 1) : ((end - begin) / 4 + 1);
+	auto block = static_cast<DREAMPORTS_BLOCK*>(calloc(1, sizeof(DREAMPORTS_BLOCK) + (count + 1) * sizeof(uint32)));
+	block->processor = processor;
+	block->begin = begin;
+	block->count = count;
+	block->step = step;
+	for(uint32 i = 0; i < count; i++)
+	{
+		block->words[i] = context.m_pMemoryMap->GetInstruction(begin + i * step);
+	}
+	if(count >= 2)
+	{
+		uint32 delayUpper = vu ? context.m_pMemoryMap->GetInstruction(begin + (count - 1) * step + 4) : 0;
+		block->branch = DreamportsBranchKind(processor, block->words[count - 2], delayUpper);
+		// the pair a vector unit runs after the delay slot when its branch isn't taken
+		if(block->branch == 3) block->words[count] = context.m_pMemoryMap->GetInstruction(begin + count * step);
+	}
+	g_dreamportsCompiling.index = static_cast<uint32>(g_dreamportsBlocks.size());
+	g_dreamportsBlocks.push_back(block);
+	return g_dreamportsCompiling.index;
+}
+
+// on the EE and the IOP, when the tools follow each instruction, a call before it with what the registers hold
+static void CompileDreamportsStep(CMipsJitter* jitter, uint32 index, uint32 position)
+{
+	if(index == ~0U || !Dreamports::g_step) return;
+	if(g_dreamportsBlocks[index]->processor > Dreamports::PROCESSOR_IOP) return;
+	jitter->PushCtx();
+	jitter->PushCst(index);
+	jitter->PushCst(position);
+	jitter->Call(reinterpret_cast<void*>(&DreamportsStep), 3, Jitter::CJitter::RETURN_VALUE_NONE);
+}
