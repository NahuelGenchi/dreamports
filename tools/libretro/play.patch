+// The console's memories, as the tools compare them (tools/lib/memory.mjs): `memory` 0 the EE's, at its own addresses (main
+// memory from 0, the scratchpad at 0x70000000, vector unit 0's code and data at 0x11000000 and 0x11004000, vector unit
+// 1's at 0x11008000 and 0x1100C000), 1 the IOP's (its memory from 0, its scratchpad at 0x1F800000) and 2 the SPU2's.
+// Each is the console's size, though Play! keeps more of some. Where `bytes` from `address` are, or none when they
+// aren't all in one of them. Read as the console waits at a V-blank
+extern "C" RETRO_API const uint8_t* dreamports_memory(uint32_t memory, uint32_t address, uint32_t bytes)
+{
+	auto& ee = m_virtualMachine->m_ee;
+	auto& iop = m_virtualMachine->m_iop;
+	const struct
+	{
+		uint32_t memory, from, size;
+		uint8* at;
+	} regions[] = {
+	    {0, 0, 0x02000000, ee->m_ram}, {0, 0x70000000, PS2::EE_SPR_SIZE, ee->m_spr},
+	    {0, PS2::MICROMEM0ADDR, PS2::MICROMEM0SIZE, ee->m_microMem0}, {0, PS2::VUMEM0ADDR, PS2::VUMEM0SIZE, ee->m_vuMem0},
+	    {0, PS2::MICROMEM1ADDR, PS2::MICROMEM1SIZE, ee->m_microMem1}, {0, PS2::VUMEM1ADDR, PS2::VUMEM1SIZE, ee->m_vuMem1},
+	    {1, 0, 0x00200000, iop->m_ram}, {1, 0x1F800000, 0x400, iop->m_scratchPad}, {2, 0, PS2::SPU_RAM_SIZE, iop->m_spuRam},
+	};
