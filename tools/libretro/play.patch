+//Dreamports: queues the MAC flags on the stack, zero, sign, underflow and overflow for each field, and what they
+//make of the sticky ones, to be seen four cycles on
+static void DpQueueFlags(CMipsJitter* codeGen, uint32 relativePipeTime, uint32 compileHints)
+{
+	//Update sticky flags
+	{
+		codeGen->PushTop();
+
+		//Load previous value
+		{
+			codeGen->PushRelAddrRef(offsetof(CMIPS, m_State.pipeSticky.values));
+
+			codeGen->PushRel(offsetof(CMIPS, m_State.pipeSticky.index));
+			codeGen->PushCst(1);
+			codeGen->Sub();
+			codeGen->PushCst(FLAG_PIPELINE_SLOTS - 1);
+			codeGen->And();
+
+			codeGen->LoadFromRefIdx();
+		}
+
+		codeGen->Or();
+		QueueInFlagPipeline(g_pipeInfoSticky, codeGen, LATENCY_MAC, relativePipeTime);
+	}
+
+	if((compileHints & COMPILEHINT_SKIP_FMAC_UPDATE) == 0)
+	{
+		QueueInFlagPipeline(g_pipeInfoMac, codeGen, LATENCY_MAC, relativePipeTime);
+	}
+	else
+	{
+		codeGen->PullTop();
+	}
+}
+
+//Dreamports: a sum on the console's float rules, a field at a time: its result into fd, and its MAC flags queued.
+//With `expand`, ft is one value every field takes, kept as the sum starts, as its register can be the one written
+static void DpFmac(CMipsJitter* codeGen, uint32 op, uint8 dest, size_t fd, size_t fs, size_t ft, bool expand, uint32 relativePipeTime, uint32 compileHints)
+{
+	if(expand)
+	{
+		codeGen->PushRel(ft);
+		codeGen->PullRel(offsetof(CMIPS, m_State.nCOP2T));
+	}
+	codeGen->PushCst(0);
+	for(unsigned int i = 0; i < 4; i++)
+	{
+		if(!DestinationHasElement(dest, i)) continue;
+		codeGen->PushCst(op | (i << 8));
