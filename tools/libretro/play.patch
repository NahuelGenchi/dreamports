+// Serves whatever calls are waiting, after waiting for one at most this many milliseconds, flip or not
+void CGSHandler::ProcessPendingCalls(unsigned int waitMs)
+{
+	assert(!m_gsThreaded);
+	if(waitMs != 0)
+	{
+		m_mailBox.WaitForCall(waitMs);
+	}
+	while(m_mailBox.IsPending())
+	{
+		m_mailBox.ReceiveCall();
+	}
+	m_flipped = false;
