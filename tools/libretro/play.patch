+// The EE's registers as the function check gives and takes them, 327 words (tools/ps2/original.mjs, EE_REGISTERS): its
+// 32 registers, 128 bits each, HI and LO and their upper halves, SA, the FPU's registers, its accumulator and its
+// control word, and vector unit 0's registers, accumulator, integer registers, Q, I, P, R and its flags. And `next`, where
+// the EE goes after the block it's ending, or 1 when no jump waits. For the tools to keep a function's start as play
+// reaches it (tools/libretro/starts.h), asked from the block's own callback, on the EE's thread
+extern "C" RETRO_API const uint32_t* dreamports_registers(uint32_t* next)
+{
+	static uint32_t words[327];
+	const auto& state = m_virtualMachine->m_ee->m_EE.m_State;
+	uint32_t* at = words;
+	const auto take = [&](const void* from, size_t bytes) {
+		memcpy(at, from, bytes);
+		at += bytes / 4;
+	};
+	take(state.nGPR, sizeof(state.nGPR));
+	take(state.nHI, 8);
+	take(state.nLO, 8);
+	take(state.nHI1, 8);
+	take(state.nLO1, 8);
+	take(&state.nSA, 4);
+	take(state.nCOP1, sizeof(state.nCOP1));
+	take(&state.nCOP1A, 4);
+	take(&state.nFCSR, 4);
+	take(state.nCOP2, 32 * 16);
+	take(&state.nCOP2A, 16);
+	take(state.nCOP2VI, sizeof(state.nCOP2VI));
+	take(&state.nCOP2Q, 4);
+	take(&state.nCOP2I, 4);
+	take(&state.nCOP2P, 4);
+	take(&state.nCOP2R, 4);
+	take(&state.nCOP2SF, 4);
+	take(&state.nCOP2MF, 4);
+	take(&state.nCOP2CF, 4);
+	take(&state.nCOP2DF, 4);
+	static_assert(sizeof(state.nGPR) == 512 && sizeof(state.nCOP1) == 128 && sizeof(state.nCOP2VI) == 64, "the EE's registers aren't the size the tools take them for");
