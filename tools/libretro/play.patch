+{
+	// what was sent, and how much of it this core took, is part of the sound list
+	uint32 taken = ReceiveDmaTaken(buffer, blockSize, blockAmount, direction);
+	{
+		uint32 about[4] = {m_spuNumber, m_transferMode, static_cast<uint32>(m_ctrl & CONTROL_DMA), blockSize * taken};
+		SoundList::Add('D', about, sizeof(about));
+		// the bytes moved, sent to the core or read from it
+		if(taken) SoundList::Add('d', buffer, blockSize * taken, false);
+	}
+	return taken;
+}
