+	// The draw list: everything the console has given the GS that decides its picture, hashed in the order given
+	// (FNV-1a), with how many things that was. The frontend reads it at each V-blank and starts it again.
+	uint32 m_drawListHash = 0x811C9DC5;
+	uint32 m_drawListCount = 0;
+	// When the frontend opens one, a file the whole list goes to as well, for the tools to read what a game's lists
+	// hold: each thing as a letter and what was written, 'R' a register and its 64 bits, 'S' an address and half of one
+	// of the screen's registers, 'I' a picture's length and the hash of its bytes, which stay out of the file, and from
+	// the others 'P', the path the register writes after it came by, and 'F', the end of a frame.
+	FILE* m_drawListDump = nullptr;
+	void AddToDrawList(char kind, const void* data, size_t length)
+	{
+		auto bytes = static_cast<const uint8*>(data);
+		uint32 own = 0x811C9DC5;
+		for(size_t i = 0; i < length; i++)
+		{
+			m_drawListHash = (m_drawListHash ^ bytes[i]) * 0x01000193;
+			own = (own ^ bytes[i]) * 0x01000193;
+		}
+		m_drawListCount++;
+		if(!m_drawListDump) return;
+		fputc(kind, m_drawListDump);
+		if(kind == 'I')
+		{
+			uint32 about[2] = {static_cast<uint32>(length), own};
+			fwrite(about, 4, 2, m_drawListDump);
+		}
+		else
+		{
+			fwrite(data, 1, length, m_drawListDump);
+		}
+	}
+	void NoteInDrawListDump(char kind, uint8 value)
+	{
+		if(!m_drawListDump) return;
+		fputc(kind, m_drawListDump);
+		if(kind == 'P') fputc(value, m_drawListDump);
+	}
 
