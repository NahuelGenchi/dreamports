+// One frame of the console for each retro_run, so the same buttons at the same frames give the same pictures and sound.
+// The console's thread waits at each V-blank, before it reads the buttons, until the frontend asks for the next frame
+// (WaitAtVBlank, from the pad handler), and the frontend serves the GS's calls until the console has got there.
+// Never destroyed, as the console's thread can still be waiting on them when the frontend ends
+static std::mutex& g_vblankMutex = *new std::mutex;
+static std::condition_variable& g_vblankCondition = *new std::condition_variable;
+static uint64_t g_vblanksReached = 0;
+static uint64_t g_vblanksAllowed = 0;
+static uint64_t g_framesRun = 0;
+
+// the draw list of the frame that has just ended, for the frontend to ask for (dreamports_draw_list)
+static uint32_t g_drawListHash = 0;
+static uint32_t g_drawListCount = 0;
+// and its sound list (Iop::SoundList), for dreamports_sound_list
+static uint32_t g_soundListHash = 0;
+static uint32_t g_soundListCount = 0;
+
+void WaitAtVBlank()
+{
+	std::unique_lock<std::mutex> lock(g_vblankMutex);
+	if(auto gs = m_virtualMachine ? m_virtualMachine->GetGSHandler() : nullptr)
+	{
+		g_drawListHash = gs->m_drawListHash;
+		g_drawListCount = gs->m_drawListCount;
+		// the whole list to a file, when the environment names one, opened once the GS is there
+		static bool asked = false;
+		if(!asked)
+		{
+			asked = true;
+			if(auto path = getenv("DP_DRAW_DUMP")) gs->m_drawListDump = fopen(path, "wb");
+		}
+		gs->NoteInDrawListDump('F', 0);
+		if(gs->m_drawListDump) fflush(gs->m_drawListDump);
+		// the vector units' memories too, when the environment's DP_VU_DUMP names a file: vector unit 0's code and data,
+		// then vector unit 1's, every V-blank, for the tools to compare with a Dreamport's (kit/ps2/c/vu.c)
+		static FILE* vuDump = nullptr;
+		static bool vuAsked = false;
+		if(!vuAsked)
+		{
+			vuAsked = true;
+			if(auto path = getenv("DP_VU_DUMP")) vuDump = fopen(path, "wb");
+		}
+		if(vuDump)
+		{
+			auto& ee = *m_virtualMachine->m_ee;
+			fwrite(ee.m_microMem0, 1, PS2::MICROMEM0SIZE, vuDump);
+			fwrite(ee.m_vuMem0, 1, PS2::VUMEM0SIZE, vuDump);
+			fwrite(ee.m_microMem1, 1, PS2::MICROMEM1SIZE, vuDump);
+			fwrite(ee.m_vuMem1, 1, PS2::VUMEM1SIZE, vuDump);
+			fflush(vuDump);
+		}
+		gs->m_drawListHash = 0x811C9DC5;
+		gs->m_drawListCount = 0;
+	}
+	{
+		// the sound list the same way, its file opened once, when the environment names one
+		Iop::SoundList::Open();
+		g_soundListHash = Iop::SoundList::hash;
+		g_soundListCount = Iop::SoundList::count;
+		if(Iop::SoundList::dump)
+		{
+			fputc('F', Iop::SoundList::dump);
+			fflush(Iop::SoundList::dump);
+		}
+		Iop::SoundList::hash = 0x811C9DC5;
+		Iop::SoundList::count = 0;
+	}
+	g_vblanksReached++;
+	// the console's clock goes on as its V-blanks do: 59.94 a second, or 50 on a PAL screen (DreamportsWatch.h)
+	Dreamports::g_vblanks++;
+	if(auto gs = m_virtualMachine ? m_virtualMachine->GetGSHandler() : nullptr) Dreamports::g_vblankMilliHertz = gs->GetCrtFrameRate() == 50 ? 50000 : 59940;
+	g_vblankCondition.notify_all();
+	g_vblankCondition.wait(lock, [] { return g_vblanksAllowed >= g_vblanksReached; });
+}
