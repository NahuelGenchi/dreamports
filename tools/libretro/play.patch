diff --git a/Source/DreamportsWatch.h b/Source/DreamportsWatch.h
new file mode 100644
index 0000000..fa5a952
--- /dev/null
+++ b/Source/DreamportsWatch.h
@@ -0,0 +1,59 @@
+#pragma once
+
+// Dreamports: what the tools' program is told of the console as it plays (tools/libretro/play.patch, ran-ps2.h). Nothing
+// here changes what the console does: a block that runs only says so, and a sector read only says which it was.
+
+#include "Types.h"
+#include <ctime>
+
+// A block of instructions as the processor compiled it, the same as ran-ps2.h's struct dpBlock
+struct DREAMPORTS_BLOCK
+{
+	uint32 processor; // 0 the EE, 1 the IOP, 2 vector unit 0, 3 vector unit 1
+	uint32 begin;     // the address of its first instruction
+	uint32 count;     // how many instructions it has, or on a vector unit how many pairs
+	uint32 step;      // how many bytes apart they are: 4, or 8 on a vector unit
+	uint32 branch;    // 0 it ends with no conditional branch, 1 with one, 2 a likely one, whose delay slot runs only when it's
+	                  // taken, 3 a vector unit's whose delay slot has its E bit, so the pair after runs when it isn't
+	uint32 kept[7];   // the tools' own
+	uint32 words[1];  // each instruction's word as compiled, the lower of a pair on a vector unit
+};
+
+namespace Dreamports
+{
+	enum
+	{
+		PROCESSOR_EE,
+		PROCESSOR_IOP,
+		PROCESSOR_VU0,
+		PROCESSOR_VU1,
+		PROCESSORS
+	};
+
+	// set by the frontend before a block compiles: the processors' contexts, which processor each is, and what to tell
+	extern void* g_processors[PROCESSORS];
+	extern void (*g_blockRan)(DREAMPORTS_BLOCK*, uint32 jumped);
+	extern void (*g_step)(DREAMPORTS_BLOCK*, uint32 position, const void* registers);
+	extern void (*g_sectorRead)(uint32 sector);
+
+	inline void SectorRead(uint32 sector)
+	{
+		if(g_sectorRead) g_sectorRead(sector);
+	}
+
+	// The console's clock, the same in every run: midnight on 1 January 2001, Coordinated Universal Time, as the console
+	// starts, going on as its V-blanks do, which the frontend counts, with how many thousand a second (main_libretro.cpp)
+	enum : time_t
+	{
+		CLOCK_START = 978307200
+	};
+	extern uint64 g_vblanks;
+	extern uint32 g_vblankMilliHertz;
+	inline time_t ConsoleTime()
+	{
+		return CLOCK_START + static_cast<time_t>(g_vblanks * 1000 / g_vblankMilliHertz);
+	}
+
+	// how many times a memory card has been changed, for the tools to read its files again (Iop_McServ.cpp)
+	extern uint32 g_memoryCardChanges;
+}
