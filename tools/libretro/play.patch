+// One frame of the console for each retro_run, so the same buttons at the same frames give the same pictures and sound.
+// The console's thread waits at each V-blank, before it reads the buttons, until the frontend asks for the next frame
+// (WaitAtVBlank, from the pad handler), and the frontend serves the GS's calls until the console has got there.
+// Never destroyed, as the console's thread can still be waiting on them when the frontend ends
+static std::mutex& g_vblankMutex = *new std::mutex;
+static std::condition_variable& g_vblankCondition = *new std::condition_variable;
+static uint64_t g_vblanksReached = 0;
+static uint64_t g_vblanksAllowed = 0;
+static uint64_t g_framesRun = 0;
+
+// the draw list of the frame that has just ended, for the frontend to ask for (dreamports_draw_list)
+static uint32_t g_drawListHash = 0;
+static uint32_t g_drawListCount = 0;
+
+void WaitAtVBlank()
+{
+	std::unique_lock<std::mutex> lock(g_vblankMutex);
+	if(auto gs = m_virtualMachine ? m_virtualMachine->GetGSHandler() : nullptr)
+	{
+		g_drawListHash = gs->m_drawListHash;
+		g_drawListCount = gs->m_drawListCount;
+		gs->m_drawListHash = 0x811C9DC5;
+		gs->m_drawListCount = 0;
+	}
+	g_vblanksReached++;
+	g_vblankCondition.notify_all();
+	g_vblankCondition.wait(lock, [] { return g_vblanksAllowed >= g_vblanksReached; });
+}
+
+// What the console gave the GS in the frame the last retro_run ran: its hash and how many things it was
+extern "C" RETRO_API void dreamports_draw_list(uint32_t* hash, uint32_t* count)
+{
+	std::lock_guard<std::mutex> lock(g_vblankMutex);
+	*hash = g_drawListHash;
+	*count = g_drawListCount;
+}
+
+static void AllowVBlanks(uint64_t count)
+{
+	std::lock_guard<std::mutex> lock(g_vblankMutex);
+	g_vblanksAllowed = count;
+	g_vblankCondition.notify_all();
+}
+
+static bool HasReachedVBlank(uint64_t count)
+{
+	std::lock_guard<std::mutex> lock(g_vblankMutex);
+	return g_vblanksReached >= count;
+}
