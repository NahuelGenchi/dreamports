// @TITLE_JS@: the player's copy, checked and kept in this browser, then the game a frame at a time, on what the kits
// share (kit/gba/, docs/CONSOLES.md), at the console's own screen, rate and buttons (kit/consoles.js).

import '../../../kit/gba/canvas.js';
import { createRomSetup } from '../../../kit/gba/ui/rom-setup.js';
import { createRomStore } from '../../../kit/gba/rom/store.js';
import { sha1Hex } from '../../../kit/gba/rom/identify.js';
import { createClock } from '../../../kit/gba/clock.js';
import { createInput } from '../../../kit/gba/input.js';
import { proof } from '../../../kit/gba/proof.js';
import { createSettings } from '../../../kit/gba/ui/settings.js';
import { createTouch } from '../../../kit/gba/ui/touch.js';
import { CONSOLES, layoutOf } from '../../../kit/consoles.js';

const MACHINE = CONSOLES[@CONSOLE_JS@];
const GAME = { name: @NAME_JS@, versions: [{ sha1: @SHA1_JS@ }] };

const picker = document.getElementById('picker');
const stage = document.getElementById('stage');
const screen = document.getElementById('screen');
const input = createInput(layoutOf(@CONSOLE_JS@));
proof?.watch(screen, input);   // for the proof tools: ?proof plays recorded buttons, ?proof=record keeps them
const touch = createTouch(stage, input, { screen, key: @FOLDER_JS@ });
createSettings(stage, input, { touch });
let rom = null;

createRomSetup(picker, {
  brand: @TITLE_QUOTED@,
  home: @HOME_JS@,
  roms: createRomStore(@FOLDER_JS@),
  heading: 'Insert your copy',
  intro: 'Your copy stays on this device.',
  slots: [{
    key: 'game', store: 'rom', title: GAME.name, required: true, accept: MACHINE.files.join(','), console: MACHINE.name, maxBytes: MACHINE.largest,
    claims: () => true,
    async read(buffer) {
      const sha1 = await sha1Hex(buffer);
      rom = new Uint8Array(buffer);
      return GAME.versions.some(version => version.sha1 === sha1) ? 'tested version' : 'untested version';
    },
    unload() { rom = null; },
  }],
  onPlay: start,
});

// the game's own code: what the original does each frame, then its picture. To begin with, one colour: blue, and green
// while a button is held
function createGame() {
  return {
    step() { this.held = MACHINE.buttons.some(name => input[name.toLowerCase()]); },
    draw(pixels) { pixels.fill(this.held ? 0xFF00FF00 : 0xFFFF0000); },
  };
}

function start() {
  picker.hidden = true;
  stage.hidden = false;
  const game = createGame();
  const out = screen.getContext('2d', { alpha: false });
  [screen.width, screen.height] = MACHINE.screen;
  const image = out.createImageData(screen.width, screen.height), pixels = new Uint32Array(image.data.buffer);
  // at the console's own rate: each of the display's frames runs the game's frames that are due, then draws
  const clock = createClock(1000 * MACHINE.frame[0] / MACHINE.frame[1]);
  clock.reset();
  input.enabled = true;
  requestAnimationFrame(function loop(now) {
    let ran = false;
    for (let n = clock.steps(now); n > 0; n--) {
      input.poll();
      game.step();
      ran = true;
    }
    if (ran) {
      game.draw(pixels);
      out.putImageData(image, 0, 0);
    }
    requestAnimationFrame(loop);
  });
  screen.focus();
}
