@@ -447,6 +451,7 @@ void X6502_Run(int32_t cycles)
 
 		_PI = _P;
 		b1 = RdMem(_PC);
+		if (DreamportsRan) DreamportsRan(_PC, b1, _A | _X << 8 | _Y << 16 | (uint32_t)_S << 24, _P);
 
 		ADDCYC(CycTable[b1]);
 
