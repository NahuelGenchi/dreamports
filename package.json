    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261023.1",
    "typescript": "6.0.3",
    "wrangler": "4.154.0"
  }
}
