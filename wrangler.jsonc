// How Cloudflare serves dreamports.net. The site is plain files: `npm run build`
// writes them to dist/, and Cloudflare uploads that folder as it is, with no server code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dreamports",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    // An address with no page shows the site's own 404 page (src/pages/404.astro).
    "not_found_handling": "404-page"
  },
  // The site's only public address. Cloudflare creates its DNS record and HTTPS certificate.
  "routes": [{ "pattern": "dreamports.net", "custom_domain": true }],
  // No dreamports.<account>.workers.dev copy of the site, but pull requests keep their preview links.
  "workers_dev": false,
  "preview_urls": true
}
