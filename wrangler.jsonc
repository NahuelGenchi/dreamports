// How Cloudflare serves dreamports.net. `npm run build` writes the site's pages and the games in games/
// to dist/, and Cloudflare serves that folder as plain files. A small Worker, worker/index.ts, answers
// only the addresses in `run_worker_first`: the accounts API and players' public profiles.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dreamports",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // An address with no page shows the site's own 404 page (src/pages/404.astro).
    "not_found_handling": "404-page",
    // Only these run the Worker. The games under /play/ stay plain files: Cloudflare's free plan serves
    // those without limit but runs the Worker at most 100,000 times a day, and Sonic Advance Dreamport
    // alone loads over 200 files each time it starts.
    "run_worker_first": ["/api/*", "/players/*"]
  },
  // The accounts' database (docs/ACCOUNTS.md). The Worker makes its tables itself the first time.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dreamports-accounts",
      "database_id": "ffd8acb5-7503-4985-afa7-b4a176eb0a9b"
    }
  ],
  // Each sign-in service's id for the site's app (docs/ACCOUNTS.md). Their secrets are kept by Cloudflare,
  // set with `npx wrangler secret put` and, for previews, `npx wrangler preview base-config secret put`.
  "vars": {
    "GOOGLE_CLIENT_ID": "688081000228-e4dciu1p1tameag927vuqch8q32n1tmb.apps.googleusercontent.com",
    "DISCORD_CLIENT_ID": "1565515672354558032",
    "GITHUB_CLIENT_ID": "Iv23li98a7JtNiBVJyCL"
  },
  // The site's only public address. Cloudflare creates its DNS record and HTTPS certificate.
  "routes": [{ "pattern": "dreamports.net", "custom_domain": true }],
  // No dreamports.<account>.workers.dev copy of the site, but pull requests keep their preview links.
  "workers_dev": false,
  "preview_urls": true,
  // Pull request previews, made with `npx wrangler preview`, take nothing from the live site's settings:
  // the same sign-in apps, but their own database, so trying a preview never touches players' real
  // profiles.
  "previews": {
    "vars": {
      "GOOGLE_CLIENT_ID": "688081000228-e4dciu1p1tameag927vuqch8q32n1tmb.apps.googleusercontent.com",
      "DISCORD_CLIENT_ID": "1565515672354558032",
      "GITHUB_CLIENT_ID": "Iv23li98a7JtNiBVJyCL"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "dreamports-accounts-previews",
        "database_id": "49fcbd1e-76ff-4f4c-b81d-de34aea1b999"
      }
    ]
  }
}
